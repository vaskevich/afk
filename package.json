{
  "name": "afk-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.13.1",
  "scripts": {
    "dev:server": "pnpm --filter @afk/server dev",
    "dev:web": "pnpm --filter @afk/web dev",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:sh": "if command -v shellcheck >/dev/null 2>&1; then shellcheck cli/afk; else echo 'shellcheck not installed (brew install shellcheck); skipping lint:sh'; fi",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build": "pnpm -r build",
    "test": "vitest run",
    "test:contract": "vitest run --config vitest.contract.config.ts",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@afk/shared": "workspace:*",
    "@eslint/js": "^10.0.1",
    "@hono/node-server": "^1.13.0",
    "@testing-library/react": "^16.3.3",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-promise": "^7.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.0"
  }
}
