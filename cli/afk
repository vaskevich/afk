#
# afk — away-from-keyboard telemetry for your machine.
#
# Starts a session, samples machine health once a second (and the busiest processes
# every few seconds), and streams it to an afk server so you can watch a shareable
# dashboard from your phone. Designed to be downloaded, read, and run: plain bash 3.2
# (what macOS ships), curl, and stock macOS tools only. No jq, no python.
#
# Usage:
#   afk start [--no-qr] [--force]
#                        start a session in the foreground (Ctrl-C to end it); refuses
#                        while another `afk start` runs here unless --force ends it
#   afk run [--no-qr] -- <cmd>
#                        run a command and report its progress; joins the session
#                        started by `afk start` if one is running on this machine,
#                        otherwise starts one (with machine telemetry) for the
#                        lifetime of the command
#   afk status           show the session running on this machine, its queue (the
#                        joined runs' included), what the queue cap dropped, and the
#                        runs still going
#   afk stop             end that session (asks the `afk start` process to finish)
#   afk qr               print the current session's dashboard URL as a QR code again
#   afk update           replace this copy with the client the server serves (the same
#                        installer as curl -fsSL <origin>/install | sh), in this copy's
#                        directory unless AFK_INSTALL_DIR says where
#   afk version [--check]
#                        print this copy's version; --check also asks the server which
#                        version it serves
#
# The dashboard URL is printed with a QR code under it when stdout is a terminal, so
# you can point a phone at the screen instead of typing it; --no-qr skips that.
#
# When the server serves a newer client than this one, `afk start` (and an `afk run`
# that started its own session) says so; on a terminal `afk start` also asks whether
# to update now, waiting ten seconds for the answer and taking silence as no. The new
# copy is used from the next `afk start`; the running one carries on as it is.
#
# The server caps a session (an hour by default). Shortly before that `afk start`, or
# an `afk run` that started its own session, opens a successor session that continues
# the old one and prints its URL (and QR); the two dashboards link to each other, and
# a run's frames carry on in the successor. An `afk run` that joined the old session
# follows along on its own.
#
# Environment:
#   AFK_SERVER           server origin, default https://afk.osv.im, or the server this
#                        copy was installed from (curl -fsSL <origin>/install | sh)
#   AFK_HOME             state directory, default ~/.afk
#   AFK_SPOOL_MAX_BYTES  cap on queued frames on disk, default 50 MiB; oldest dropped past it
#   AFK_NO_QR            set to 1 to never print the QR code (same as --no-qr)
#   AFK_NO_UPDATE_PROMPT set to 1 to never be asked to update (the notice still prints)
#   AFK_INSTALL_DIR      where `afk update` and the prompt install the new copy; default
#                        is this copy's own directory
#   AFK_RUN_TAIL_LINES   how many of the last lines of stdout and stderr a failed `afk run`
#                        reports, default 20; 0 sends no output at all (exit 0 never sends any)
#   AFK_RUN_CAPTURE_MAX_BYTES
#                        how much of a wrapped command's stdout and stderr `afk run` keeps
#                        on disk while it runs, per chunk, default 64 MiB; at most two
#                        chunks per stream are kept, and all of it is deleted when the
#                        command exits (see run_capture_sink)
#
# Layout of ~/.afk:
#   current                        the active session (id, token, server) so other
#                                  afk processes can join it
#   owner.pid                      pid of the process that created it; a dead owner
#                                  marks `current` stale without asking the server
#   sessions/<id>/session.json     the same record, kept with the session's files so a
#                                  later `afk start` can send what was left in its queue
#                                  (a session that ended while the server was unreachable)
#   sessions/<id>/auth             the ingest token as a curl config file (`header = ...`),
#                                  so curl reads it with -K instead of showing it in `ps`
#   sessions/<id>/queue/<seq>-<stream>.ndjson
#                                  one sampled frame per file, waiting to be sent; a
#                                  batch is the oldest files concatenated, deleted on 2xx
#   sessions/<id>/dropped          how many frames (and bytes) the queue cap threw away
#                                  during an outage; `afk status` shows it
#   sessions/<id>/done            written when the session ended (or was continued by
#                                  a successor); `afk start` removes session
#                                  directories a day after this (two days after their
#                                  last change if it is missing)
#   sessions/<id>/runs/<runId>/    an `afk run`: the command's pid and command line, the
#                                  newest chunks of its stdout and stderr (capped, and
#                                  deleted when it exits), and (when it joined an
#                                  existing session) its own queue
# The directory and everything in it are readable by the user alone (mode 700 and 600).
#
# The client is deliberately dumb: it ships raw measurements and lets the server
# decide what is normal. That way the server can improve without anyone re-downloading
# this script.

set -u

# Everything this script writes is private to the user: `current` holds the ingest
# token, and the spool and run captures hold what the machine and its commands were
# doing. The command `afk run` wraps gets the caller's umask back (see cmd_run) so its
# own files are created the way they would be unwrapped.
ORIGINAL_UMASK=$(umask)
umask 077

# Client version (semver, bumped on every release) and the protocol version it speaks
# (bumped only for an incompatible wire change). See docs/VERSIONING.md.
AFK_VERSION="0.2.0"
AFK_PROTOCOL_VERSION=1
# The installer (`curl -fsSL <origin>/install | sh`) rewrites the next line so a copy
# installed from a self-hosted server defaults to that server; the marker comment is
# what it matches on. Keep the hosted default here in the repo.
AFK_SERVER="${AFK_SERVER:-https://afk.osv.im}" # afk-install: default server
AFK_HOME="${AFK_HOME:-$HOME/.afk}"

# The sampler ticks once per SAMPLE_INTERVAL_SECONDS; each collector runs on every tick
# or, for the slower ones, every N seconds (must be a multiple of the tick).
SAMPLE_INTERVAL_SECONDS=1
# A sampler further behind schedule than this (the machine slept) skips ahead instead
# of catching up tick by tick; see system_sampler_loop.
SAMPLE_MAX_CATCHUP_SECONDS=2
PROCESSES_INTERVAL_SECONDS=5
# How many of the busiest processes a processes frame carries (PROCESSES_TOP_MAX in shared).
PROCESSES_TOP_MAX=10
# Full executable paths are cut to this many characters (PROCESS_COMMAND_MAX_LENGTH in shared).
PROCESS_COMMAND_MAX_LENGTH=512
# A failed `afk run` puts the last AFK_RUN_TAIL_LINES lines of its stdout and stderr on its
# final frame, at most RUN_TAIL_MAX_LINES (the same name in shared), each cut to
# RUN_TAIL_MAX_LINE_CHARS bytes. 0 is the privacy switch: no output leaves the machine.
RUN_TAIL_MAX_LINES=20
RUN_TAIL_MAX_LINE_CHARS=200
AFK_RUN_TAIL_LINES="${AFK_RUN_TAIL_LINES:-$RUN_TAIL_MAX_LINES}"
# `afk run` keeps the wrapped command's stdout and stderr on disk in chunks of exactly
# this many bytes, only the newest RUN_CAPTURE_KEEP_CHUNKS of them, so a command that
# prints gigabytes costs at most two chunks per stream (see run_capture_sink). Anything
# but a positive integer falls back to the default.
RUN_CAPTURE_DEFAULT_MAX_BYTES=67108864
case "${AFK_RUN_CAPTURE_MAX_BYTES:-}" in
  ''|*[!0-9]*|0) RUN_CAPTURE_MAX_BYTES=$RUN_CAPTURE_DEFAULT_MAX_BYTES ;;
  *) RUN_CAPTURE_MAX_BYTES=$AFK_RUN_CAPTURE_MAX_BYTES ;;
esac
RUN_CAPTURE_KEEP_CHUNKS=2
# The wrapped command line is kept for `afk status` cut to this many characters.
RUN_COMMAND_MAX_CHARS=256
# split names chunks with this many letters after the prefix: 26^6 chunks of 64 MiB.
RUN_CAPTURE_SUFFIX_LENGTH=6
SEND_INTERVAL_SECONDS=1
SEND_MAX_BACKOFF_SECONDS=30
SEND_MAX_FILES_PER_BATCH=200
# The queue is capped so a laptop that is offline overnight cannot fill its disk: past
# this many bytes the oldest frames are dropped (and a line logged, at most this often).
SPOOL_MAX_BYTES="${AFK_SPOOL_MAX_BYTES:-52428800}"
SPOOL_DROP_LOG_INTERVAL_SECONDS=60

# When the server is at capacity, `afk start` waits and retries this often, for at most this long.
CAPACITY_RETRY_SECONDS=30
CAPACITY_MAX_WAIT_SECONDS=600
# `afk start` on a terminal waits this long for an answer to "update now?" before
# taking it as no; a start nobody is watching is delayed by at most this.
UPDATE_PROMPT_TIMEOUT_SECONDS=10

# `afk start` opens its successor session this long before the server's cap, so the
# old session's last frames are sent while it still accepts them: 30 s for the default
# hour, a quarter of a shorter cap (tests and local runs use caps of seconds), never
# under 2 s. See chain_before_cap_seconds and chain_session.
CHAIN_BEFORE_CAP_MAX_SECONDS=30
CHAIN_BEFORE_CAP_MIN_SECONDS=2
CHAIN_BEFORE_CAP_DIVISOR=4
# A chain that failed (server unreachable, or it refused) is retried this often until the cap.
CHAIN_RETRY_SECONDS=5
# A session the server closed early (frame cap, or ended after the machine slept) is
# continued too, but not when it is this young: a server that answers 410 to everything
# must not produce a session every few seconds.
CHAIN_MIN_SESSION_SECONDS=60
# `afk start --force` waits this long for the old owner to flush its queue and exit.
FORCE_TAKEOVER_WAIT_SECONDS=30

# `afk start` removes old session directories on startup: ended ones (a `done` marker)
# after a day, ones that never ended (a crash) two days after they last changed.
SESSION_DONE_RETENTION_SECONDS=86400
SESSION_ORPHAN_RETENTION_SECONDS=172800

# ---------------------------------------------------------------------------
# helpers
# ---------------------------------------------------------------------------

log()  { printf 'afk: %s\n' "$*" >&2; }
die()  { log "error: $*"; exit 1; }

# Escape a string for use inside a JSON string literal.
json_string() {
  printf '%s' "$1" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g' -e 's/	/\\t/g' | tr -d '\n\r'
}

# Extract a top-level string value from compact JSON (the server always emits compact JSON).
json_get_string() { # json key
  printf '%s' "$1" | sed -n 's/.*"'"$2"'":"\([^"]*\)".*/\1/p'
}
json_get_number() { # json key
  printf '%s' "$1" | sed -n 's/.*"'"$2"'":\([0-9][0-9]*\).*/\1/p'
}
# The `{...}` value of a top-level key whose value holds no object of its own (the
# `client` half of /api/version), so a key that recurs inside several objects
# ("version") can be read from the right one with json_get_string.
json_get_object() { # json key
  printf '%s' "$1" | sed -n 's/.*"'"$2"'":\({[^{}]*}\).*/\1/p'
}

# True when version $1 is older than $2: major.minor.patch compared numerically part
# by part (0.10.0 is newer than 0.9.0), a pre-release or build suffix ignored, a
# missing part 0. macOS has no `sort -V`.
version_lt() { # a b
  local a=${1%%[-+]*} b=${2%%[-+]*} part_a part_b
  while [ -n "$a" ] || [ -n "$b" ]; do
    part_a=${a%%.*}
    part_b=${b%%.*}
    case "$a" in *.*) a=${a#*.} ;; *) a="" ;; esac
    case "$b" in *.*) b=${b#*.} ;; *) b="" ;; esac
    case "$part_a" in ''|*[!0-9]*) part_a=0 ;; esac
    case "$part_b" in ''|*[!0-9]*) part_b=0 ;; esac
    if [ "$part_a" -lt "$part_b" ]; then
      return 0
    fi
    if [ "$part_a" -gt "$part_b" ]; then
      return 1
    fi
  done
  return 1
}

# The server answered 426 Upgrade Required: it will not talk to this client (or this
# protocol version) any more. Print what it said, both minimums, and how to update.
# The details are one level down in the JSON, which the key-based extraction does not mind.
log_upgrade_required() { # response-json
  local message min_client min_protocol
  message=$(json_get_string "$1" error)
  min_client=$(json_get_string "$1" minimumClientVersion)
  min_protocol=$(json_get_number "$1" minimumProtocolVersion)
  log "the server refused this client: ${message:-upgrade required}"
  log "this is afk $AFK_VERSION speaking protocol $AFK_PROTOCOL_VERSION; the server needs client ${min_client:-?} and protocol ${min_protocol:-?} or newer"
  # The server that refused us is the one whose minimum the new copy has to meet, so
  # upgrade from it: its installer checks the download and installs to ~/.local/bin,
  # or AFK_INSTALL_DIR (docs/CONFIGURATION.md), which is how to replace a copy elsewhere.
  log "update with: curl -fsSL $AFK_SERVER/install | sh"
  log "(this copy is $0; set AFK_INSTALL_DIR to its directory if that is not ~/.local/bin)"
}

now_seconds() { date +%s; }

random_id() { head -c 4 /dev/urandom | od -An -tx1 | tr -d ' \n'; }

# BSD stat (macOS) and GNU stat (Linux, where the unit tests also run) spell these
# differently; `-f` on GNU stat means the filesystem, so the two cannot be chained.
if [ "$(uname -s)" = "Darwin" ]; then
  file_size() { stat -f %z "$1" 2>/dev/null || echo 0; }
  file_mtime() { stat -f %m "$1" 2>/dev/null || now_seconds; }
else
  file_size() { stat -c %s "$1" 2>/dev/null || echo 0; }
  file_mtime() { stat -c %Y "$1" 2>/dev/null || now_seconds; }
fi

file_age_seconds() { echo $(( $(now_seconds) - $(file_mtime "$1") )); }

pid_alive() { [ -n "${1:-}" ] && kill -0 "$1" 2>/dev/null; }

# Stops one of this script's background jobs (the sender, a sampler) and waits for it.
# The job is signalled first and then everything under it, so a curl in flight dies
# with its sender instead of outliving the session: bash 3.2 forks a subshell that
# only acts on TERM once its foreground child has returned when an EXIT trap was set
# at the time of the fork (create_session sets one), so signalling the sender alone
# would leave `afk stop` waiting out the rest of curl's --max-time. `wait` only knows
# this shell's own children; a sibling job (the sender, stopped from the sampler
# subshell of an `afk run` that chains) is polled instead, for at most
# JOB_STOP_POLL_LIMIT times JOB_STOP_POLL_SECONDS.
JOB_STOP_POLL_SECONDS=0.1
JOB_STOP_POLL_LIMIT=20
stop_background_job() { # pid
  local polls=0
  [ -n "${1:-}" ] || return 0
  kill_process_tree "$1"
  wait "$1" 2>/dev/null
  while pid_alive "$1" && [ "$polls" -lt "$JOB_STOP_POLL_LIMIT" ]; do
    sleep "$JOB_STOP_POLL_SECONDS"
    polls=$((polls + 1))
  done
  return 0
}

# TERMs a process and everything under it. The whole tree is listed before anything
# is signalled: the sender's request is sender -> command-substitution shell -> curl,
# and the middle one dies at once, which would hand curl to launchd before a walk
# reached it. Parents go first so a subshell with the signal pending dies the moment
# its child does, without running the rest of its loop. A second pass catches a child
# started between the listing and the kill (the sender's next sleep or curl).
KILL_TREE_PASSES=2
kill_process_tree() { # pid
  local pids
  for _ in $(seq 1 "$KILL_TREE_PASSES"); do
    pids=$(process_tree "$1")
    # shellcheck disable=SC2086 # one pid per word is the point
    kill $pids 2>/dev/null
  done
  return 0
}

# A process and its descendants, one pid per line, each parent before its children
# (pgrep -P is on every Mac).
process_tree() { # pid
  local child
  printf '%s\n' "$1"
  for child in $(pgrep -P "$1" 2>/dev/null); do
    process_tree "$child"
  done
}

# The pid that created ~/.afk/current, empty when unknown.
owner_pid() { cat "$AFK_HOME/owner.pid" 2>/dev/null; }

remove_current_session_files() { rm -f "$AFK_HOME/current" "$AFK_HOME/owner.pid"; }

# The queue holds one frame per file (see emit_frame); these size it up for the
# sender's log, `afk status`, and the disk cap. They take the session's own queue
# unless given other queue directories (`afk status` adds the joiners' queues).
queue_count() { # [queue-dir...]
  [ $# -gt 0 ] || set -- "$SESSION_DIR/queue"
  find "$@" -name '*.ndjson' -type f 2>/dev/null | wc -l | tr -d ' '
}
queue_bytes() { # [queue-dir...]
  [ $# -gt 0 ] || set -- "$SESSION_DIR/queue"
  find "$@" -name '*.ndjson' -type f -exec sh -c 'wc -c < "$1"' _ {} \; 2>/dev/null \
    | awk '{ s += $1 } END { print s + 0 }'
}

check_platform() {
  [ "$(uname -s)" = "Darwin" ] || die "only macOS is supported right now (TODO: linux)"
  command -v curl >/dev/null || die "curl is required"
  detect_curl_features
  mkdir -p "$AFK_HOME"
  # The umask above covers what this version creates; older versions created the
  # directory with the default umask, so it is tightened on every start.
  chmod 700 "$AFK_HOME" 2>/dev/null || log "warning: could not make $AFK_HOME private (chmod 700 failed)"
}

# --fail-with-body (curl 7.76+, so every macOS 8.x) makes a 4xx/5xx response exit 22
# while still saving the body; older curls fall back to the status code alone, which
# http_request reads either way.
CURL_FAIL_FLAG=""
detect_curl_features() {
  if curl --help all 2>/dev/null | grep -q -- --fail-with-body; then
    CURL_FAIL_FLAG="--fail-with-body"
  fi
}

# The bearer header for curl's config file syntax (-K). macOS shows every user's
# process arguments, so the ingest token must never be a curl argument; it goes
# through a file readable by the user alone instead. Backslashes and quotes are
# escaped the way curl's config parser reads them (the server never sends either).
auth_config_line() { # token
  printf 'header = "Authorization: Bearer %s"' \
    "$(printf '%s' "$1" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g')"
}

# The config file holding the session's bearer header, written under the session
# directory (mode 600 under the umask) the first time it is needed and rewritten when
# the token changes, as when a joiner follows its owner to a successor session. Prints
# the path, for `-K "$(auth_config_file)"`. Given a token and a directory it does the
# same for another session (a chain sends the previous session's token).
AUTH_CONFIG_NAME=auth
auth_config_file() { # [token dir]
  local token=${1:-$INGEST_TOKEN} dir=${2:-$SESSION_DIR} file line
  file="$dir/$AUTH_CONFIG_NAME"
  line=$(auth_config_line "$token")
  if [ "$(cat "$file" 2>/dev/null)" != "$line" ]; then
    mkdir -p "$dir"
    printf '%s\n' "$line" > "$file"
  fi
  printf '%s' "$file"
}

# Every request goes through here. curl's own retries are off so they never double
# up with the sender's. Leaves the HTTP status in HTTP_STATUS and returns 0 for any
# response; when there was none HTTP_STATUS is 000, HTTP_ERROR is curl's reason, and
# it returns 1. (Not a `$(...)` helper on purpose: those variables must reach the caller.)
HTTP_STATUS=000
HTTP_ERROR=""
http_request() { # curl args...
  local rc errors
  errors=$(mktemp "${TMPDIR:-/tmp}/afk-curl.XXXXXX")
  # shellcheck disable=SC2086 # CURL_FAIL_FLAG is empty or one flag, never quoted text
  HTTP_STATUS=$(curl -sS --retry 0 $CURL_FAIL_FLAG -w '%{http_code}' \
    -H "X-Afk-Client: bash/$AFK_VERSION" "$@" 2>"$errors"); rc=$?
  HTTP_ERROR=""
  case "$rc" in
    0|22) rm -f "$errors" ;;
    *)
      HTTP_STATUS=000
      HTTP_ERROR=$(cat "$errors" 2>/dev/null); rm -f "$errors"
      : "${HTTP_ERROR:=curl exited with $rc}"
      return 1 ;;
  esac
}

# ---------------------------------------------------------------------------
# collectors
#
# Each collector is a function that prints ONE compact JSON object describing the
# machine right now. The sampler wraps it in a frame envelope. Keep collectors free of
# interpretation: raw numbers in, server decides what they mean.
#
# TODO(collectors): agents (claude/codex). TODO(linux): /proc equivalents.
# TODO(plugins): allow any executable printing JSON to act as a collector.
# ---------------------------------------------------------------------------

collect_system() {
  # %cpu per process is the kernel's recent decayed average; summed and divided by
  # core count it gives "percent of the whole machine" and is cheap (~20 ms).
  local cpu load1 load5 load15 pressure swap_total_mb swap_used_mb
  cpu=$(ps -A -o %cpu= | awk -v n="$HOST_CPU_COUNT" '{ s += $1 } END { printf "%.1f", s / n }')

  # vm.loadavg looks like "{ 4.16 4.98 4.98 }"
  # shellcheck disable=SC2046 # splitting the three numbers into $1..$3 is the point
  set -- $(sysctl -n vm.loadavg | tr -d '{}')
  load1=$1; load5=$2; load15=$3

  pressure=$(sysctl -n kern.memorystatus_vm_pressure_level)

  # vm.swapusage looks like "total = 10240.00M  used = 9179.50M  free = 1060.50M  (encrypted)"
  # shellcheck disable=SC2046 # splitting the words into $1..$6 is the point
  set -- $(sysctl -n vm.swapusage | tr -d 'M')
  swap_total_mb=$3; swap_used_mb=$6

  # vm_stat prints page counts; first line carries the page size.
  vm_stat | awk -v total="$HOST_MEMORY_BYTES" -v cpu="$cpu" \
    -v l1="$load1" -v l5="$load5" -v l15="$load15" -v pressure="$pressure" \
    -v swap_total_mb="$swap_total_mb" -v swap_used_mb="$swap_used_mb" '
    /page size of/      { page = $8 }
    /^Pages free/       { free = $3 }
    /^Pages active/     { active = $3 }
    /^Pages inactive/   { inactive = $3 }
    /^Pages wired down/ { wired = $4 }
    /^Pages occupied by compressor/ { compressed = $5 }
    END {
      printf "{\"cpu\":{\"percent\":%s},", cpu
      printf "\"loadAverage\":{\"oneMinute\":%s,\"fiveMinutes\":%s,\"fifteenMinutes\":%s},", l1, l5, l15
      printf "\"memory\":{\"pressureLevel\":%d,\"totalBytes\":%d,\"freeBytes\":%d,\"activeBytes\":%d,", pressure, total, free * page, active * page
      printf "\"inactiveBytes\":%d,\"wiredBytes\":%d,\"compressedBytes\":%d,", inactive * page, wired * page, compressed * page
      printf "\"swapUsedBytes\":%d,\"swapTotalBytes\":%d}}", swap_used_mb * 1048576, swap_total_mb * 1048576
    }'
}

# The busiest processes right now. One ps call, sorted by cpu descending (-r), captured
# once: the first PROCESSES_TOP_MAX lines are the frame's `top`, the line count is how
# many processes there were. rss is KiB on macOS and is converted to bytes. `comm` is
# the full executable path and may contain spaces (.app bundles), so everything after
# the fifth column is the command; a small awk function escapes it for JSON.
collect_processes() {
  local listing total
  listing=$(ps -Aro pid=,ppid=,%cpu=,%mem=,rss=,comm=)
  total=$(printf '%s\n' "$listing" | wc -l | tr -d ' ')
  # awk reads the whole listing (instead of `head`, which closes the pipe early and makes
  # printf report a broken pipe once the listing outgrows the pipe buffer).
  printf '%s\n' "$listing" | awk -v total="$total" -v max="$PROCESSES_TOP_MAX" -v max_length="$PROCESS_COMMAND_MAX_LENGTH" '
    function json_escape(s) { gsub(/\\/, "\\\\", s); gsub(/"/, "\\\"", s); return s }
    BEGIN { printf "{\"sampledCount\":%d,\"top\":[", total }
    NR > max { next }
    {
      # Everything after the five numeric columns, spaces intact.
      match($0, /^ *[0-9]+ +[0-9]+ +[0-9.]+ +[0-9.]+ +[0-9]+ +/)
      command = substr($0, RLENGTH + 1, max_length)
      printf "%s{\"pid\":%d,\"parentPid\":%d,\"cpuPercent\":%s,\"memoryPercent\":%s,\"rssBytes\":%d,\"command\":\"%s\"}", \
        (NR > 1 ? "," : ""), $1, $2, $3, $4, $5 * 1024, json_escape(command)
    }
    END { printf "]}" }'
}

# ---------------------------------------------------------------------------
# run collector: wraps one command and reports whether it is alive and how much it
# has written. The basic "volume" flavor only counts bytes, which is enough to tell
# "still going" from "hung". Richer flavors (progress lines, JSON records) can be
# added later under output.flavor without changing the rest of the frame.
# Set up by cmd_run: RUN_ID, RUN_DIR (output chunks, pid, seq), RUN_STARTED, RUN_COMMAND_JSON.
# ---------------------------------------------------------------------------

# Where the wrapped command's output goes, once per stream (cmd_run wires stdout and
# stderr through `tee`, which mirrors them to the terminal and hands a copy here).
# split writes chunk files `<name>.aaaaaa`, `<name>.aaaaab`, ... of exactly
# RUN_CAPTURE_MAX_BYTES each, only the newest one still filling, and the collector
# deletes all but the newest RUN_CAPTURE_KEEP_CHUNKS on every tick (run_capture_bytes),
# so disk use stays under two chunks per stream however much the command prints.
#
# The byte count on every frame is `deleted chunks x chunk size + bytes still on disk`.
# That is exact and only ever grows: split finishes a chunk only when it is exactly the
# chunk size, and a chunk is only ever deleted once split has finished it. (The obvious
# alternative, one file truncated in place when it grows too large, would lose whatever
# tee wrote between measuring and truncating.) Two chunks are kept rather than one so
# the tail of a failure still has its last lines when a chunk boundary just went by.
# Everything here is deleted once the final frame has been built (remove_run_captures).
run_capture_sink() { # stdout|stderr
  split -b "$RUN_CAPTURE_MAX_BYTES" -a "$RUN_CAPTURE_SUFFIX_LENGTH" - "$RUN_DIR/$1."
}

# Cumulative bytes the command has written to the stream, after deleting the chunks
# beyond the newest RUN_CAPTURE_KEEP_CHUNKS. Glob order is split's naming order, which
# is the order the chunks were written, so the loop deletes the oldest first. The
# number deleted so far lives in `<name>-deleted` because the sampler that deletes
# during the run and the main process that builds the final frame are different
# processes.
run_capture_bytes() { # stdout|stderr
  local deleted_file="$RUN_DIR/$1-deleted" deleted count=0 f total
  deleted=$(cat "$deleted_file" 2>/dev/null || echo 0)
  for f in "$RUN_DIR/$1".*; do
    [ -e "$f" ] && count=$((count + 1))
  done
  for f in "$RUN_DIR/$1".*; do
    [ "$count" -gt "$RUN_CAPTURE_KEEP_CHUNKS" ] || break
    rm -f "$f"
    count=$((count - 1))
    deleted=$((deleted + 1))
    echo "$deleted" > "$deleted_file"
  done
  total=$((deleted * RUN_CAPTURE_MAX_BYTES))
  for f in "$RUN_DIR/$1".*; do
    [ -e "$f" ] && total=$((total + $(file_size "$f")))
  done
  echo "$total"
}

# The chunks of a stream still on disk, oldest first, as one stream of bytes.
run_capture_cat() { # stdout|stderr
  cat "$RUN_DIR/$1".* 2>/dev/null
}

remove_run_captures() {
  rm -f "$RUN_DIR"/stdout.* "$RUN_DIR"/stderr.* "$RUN_DIR/stdout-deleted" "$RUN_DIR/stderr-deleted"
}

# The `output.tail` object for the final frame of a failed run: the last
# AFK_RUN_TAIL_LINES lines of the captured stdout and stderr, each cut to
# RUN_TAIL_MAX_LINE_CHARS bytes, with `truncated` set when either stream had more lines
# than were kept. Prints nothing for exit code 0 or when the switch is 0, so the caller
# can pass the result straight to collect_run. Runs in a subshell under the C locale so
# cut counts bytes and sed never chokes on bytes that are not valid UTF-8; ANSI colour
# sequences and control characters other than tab are dropped, the latter because JSON
# strings may not contain them.
run_output_tail() { # exit-code
  (
    export LC_ALL=C
    local lines name count line json first truncated=false stdout_json="" stderr_json="" esc
    esc=$(printf '\033')
    [ "${1:-0}" -ne 0 ] 2>/dev/null || exit 0
    case "$AFK_RUN_TAIL_LINES" in
      ''|*[!0-9]*) lines=$RUN_TAIL_MAX_LINES ;;
      *) lines=$AFK_RUN_TAIL_LINES ;;
    esac
    [ "$lines" -gt "$RUN_TAIL_MAX_LINES" ] && lines=$RUN_TAIL_MAX_LINES
    [ "$lines" -gt 0 ] || exit 0
    for name in stdout stderr; do
      # NR counts a final line without a newline too, which is what tail keeps. Only the
      # newest chunks are still on disk, so a run that printed more than they hold is
      # truncated whatever the count says; the count decides the rest.
      count=$(run_capture_cat "$name" | awk 'END { print NR }')
      [ "${count:-0}" -gt "$lines" ] && truncated=true
      [ "$(cat "$RUN_DIR/$name-deleted" 2>/dev/null || echo 0)" -gt 0 ] && truncated=true
      json=""; first=1
      while IFS= read -r line || [ -n "$line" ]; do
        [ "$first" = 1 ] || json="$json,"
        first=0
        json="$json\"$(json_string "$line")\""
      done < <(run_capture_cat "$name" | tail -n "$lines" | sed "s/$esc\[[0-9;]*[a-zA-Z]//g" \
        | cut -c "1-$RUN_TAIL_MAX_LINE_CHARS" | tr -d '\000-\010\013-\037\177')
      if [ "$name" = stdout ]; then stdout_json=$json; else stderr_json=$json; fi
    done
    printf '{"stdout":[%s],"stderr":[%s],"truncated":%s}' "$stdout_json" "$stderr_json" "$truncated"
  )
}

collect_run() { # state [exitCode] [output-tail-json]
  local state=$1 exit_code=${2:-null} tail=${3:-} pid out err cpu rss elapsed
  pid=$(cat "$RUN_DIR/pid" 2>/dev/null || echo 0)
  out=$(run_capture_bytes stdout)
  err=$(run_capture_bytes stderr)
  elapsed=$(( $(now_seconds) - RUN_STARTED ))
  # ps reports rss in KiB; both read as 0 once the process is gone.
  # shellcheck disable=SC2046 # splitting the two columns into $1 and $2 is the point
  set -- $(ps -o %cpu=,rss= -p "$pid" 2>/dev/null)
  cpu=${1:-0}; rss=${2:-0}
  [ -z "$tail" ] || tail=",\"tail\":$tail"
  printf '{"command":"%s","pid":%d,"state":"%s","exitCode":%s,"elapsedSeconds":%d,"process":{"cpuPercent":%s,"rssBytes":%d},"output":{"flavor":"volume","stdoutBytes":%d,"stderrBytes":%d%s}}' \
    "$RUN_COMMAND_JSON" "$pid" "$state" "$exit_code" "$elapsed" "$cpu" $((rss * 1024)) "$out" "$err" "$tail"
}

# Samples the run every second until killed. Keeps its sequence in a file so the
# final "exited" frame, emitted by the main process, can continue the count. In an
# `afk run` that owns its session (SESSION_CHAINING) the frames go to whichever
# session `current` names, so a chain by the system sampler carries the run along.
run_sampler_loop() {
  local seq=0 data
  while [ ! -s "$RUN_DIR/pid" ]; do
    sleep 0.1
  done
  while true; do
    seq=$((seq + 1))
    echo "$seq" > "$RUN_DIR/seq"
    data=$(collect_run running)
    if [ "${SESSION_CHAINING:-0}" = 1 ]; then
      follow_current_session || true
    fi
    emit_frame "run:$RUN_ID" run "$seq" "$data"
    sleep "$SAMPLE_INTERVAL_SECONDS"
  done
}

# ---------------------------------------------------------------------------
# session
# ---------------------------------------------------------------------------

gather_host_info() {
  HOST_NAME=$(hostname -s 2>/dev/null || hostname)
  HOST_PLATFORM=$(uname -s | tr '[:upper:]' '[:lower:]')
  HOST_OS_VERSION=$(sw_vers -productVersion 2>/dev/null || uname -r)
  HOST_CPU_COUNT=$(sysctl -n hw.ncpu)
  HOST_MEMORY_BYTES=$(sysctl -n hw.memsize)
}

# Creates a session. Given a previous session's id and ingest token it creates that
# session's successor instead (the token proves it is ours; see chain_session).
# Returns 0 on success, 2 when the server is at capacity (the caller chooses between
# waiting and going on without telemetry), 3 when it could not be reached, and 1 when
# it refused for good: 426 (it no longer talks to this client version; waiting would
# not change that answer, so the update hint is printed) or anything else. It never
# exits itself: a chain runs it with a sender in the background that a `die` would
# orphan.
create_session() { # [previous-session-id previous-ingest-token]
  local previous_id=${1:-} previous_token=${2:-} previous_field="" body response status
  local response_file="$AFK_HOME/create-response.json"
  if [ -n "$previous_id" ]; then
    previous_field=$(printf ',"previousSessionId":"%s"' "$(json_string "$previous_id")")
  fi
  body=$(printf '{"protocolVersion":%d,"clientVersion":"%s","host":{"hostname":"%s","platform":"%s","osVersion":"%s","cpuCount":%d,"memoryTotalBytes":%d}%s}' \
    "$AFK_PROTOCOL_VERSION" "$AFK_VERSION" "$(json_string "$HOST_NAME")" "$(json_string "$HOST_PLATFORM")" \
    "$(json_string "$HOST_OS_VERSION")" "$HOST_CPU_COUNT" "$HOST_MEMORY_BYTES" "$previous_field")

  if [ -n "$previous_id" ]; then
    http_request -o "$response_file" --connect-timeout 5 --max-time 15 \
      -H 'Content-Type: application/json' \
      -K "$(auth_config_file "$previous_token" "$AFK_HOME/sessions/$previous_id")" \
      --data "$body" "$AFK_SERVER/api/sessions"
  else
    http_request -o "$response_file" --connect-timeout 5 --max-time 15 \
      -H 'Content-Type: application/json' \
      --data "$body" "$AFK_SERVER/api/sessions"
  fi || {
    log "could not reach $AFK_SERVER: $HTTP_ERROR"
    return 3
  }
  status=$HTTP_STATUS
  response=$(cat "$response_file" 2>/dev/null)
  rm -f "$response_file"
  case "$status" in
    201) ;;
    503)
      log "server is at capacity: $(json_get_string "$response" error)"
      return 2 ;;
    426)
      log_upgrade_required "$response"
      return 1 ;;
    *)
      log "server refused to start a session (HTTP $status): $response"
      return 1 ;;
  esac

  SESSION_ID=$(json_get_string "$response" sessionId)
  INGEST_TOKEN=$(json_get_string "$response" ingestToken)
  DASHBOARD_URL=$(json_get_string "$response" dashboardUrl)
  MAX_DURATION_SECONDS=$(json_get_number "$response" maxDurationSeconds)
  # The client the server itself serves; empty from a server without one, or an older
  # server that does not say. See check_client_update.
  LATEST_CLIENT_VERSION=$(json_get_string "$response" latestClientVersion)
  if [ -z "$SESSION_ID" ] || [ -z "$INGEST_TOKEN" ]; then
    log "unexpected response from server: $response"
    return 1
  fi
  : "${MAX_DURATION_SECONDS:=3600}"

  SESSION_DIR="$AFK_HOME/sessions/$SESSION_ID"
  mkdir -p "$SESSION_DIR/queue"
  write_session_records
  echo "$$" > "$AFK_HOME/owner.pid"
  # Whatever way this process ends (Ctrl-C, `afk stop`, a die), the files that let
  # others join it must not outlive it. Bash resets traps in subshells, so the sender
  # and samplers running in the background do not trigger this when they are killed;
  # the sampler subshell of an `afk run` that chains (see cmd_run) must not set one
  # either, since the main process is still the owner.
  if [ "${BASH_SUBSHELL:-0}" = 0 ]; then
    trap remove_owner_state EXIT
  fi
}

remove_owner_state() {
  remove_current_session_files
  rm -f "$AFK_HOME/create-response.json"
}

# Two records of the session just created. `current` lets a later `afk run` join it
# and `afk status`/`afk stop` find its owner; it goes through a temp file and a rename
# so a process re-reading it during a chain never sees half of it. The session's own
# `session.json` stays with its queue after `current` is gone, so a later `afk start`
# can still send what this one could not (resend_leftover_queues).
SESSION_RECORD_NAME=session.json
write_session_records() {
  local temp="$AFK_HOME/.current.tmp"
  printf 'sessionId=%s\ningestToken=%s\nserver=%s\ndashboardUrl=%s\n' \
    "$SESSION_ID" "$INGEST_TOKEN" "$AFK_SERVER" "$DASHBOARD_URL" > "$temp" \
    && mv "$temp" "$AFK_HOME/current"
  printf '{"sessionId":"%s","ingestToken":"%s","server":"%s","dashboardUrl":"%s"}\n' \
    "$(json_string "$SESSION_ID")" "$(json_string "$INGEST_TOKEN")" \
    "$(json_string "$AFK_SERVER")" "$(json_string "$DASHBOARD_URL")" > "$SESSION_DIR/$SESSION_RECORD_NAME"
}

# Loads a session's own record (see write_session_records) into the session variables.
# Returns 1 when there is none or it is incomplete.
read_session_record() { # session-dir
  local record
  record=$(cat "$1/$SESSION_RECORD_NAME" 2>/dev/null) || return 1
  SESSION_ID=$(json_get_string "$record" sessionId)
  INGEST_TOKEN=$(json_get_string "$record" ingestToken)
  AFK_SERVER=$(json_get_string "$record" server)
  DASHBOARD_URL=$(json_get_string "$record" dashboardUrl)
  [ -n "$SESSION_ID" ] && [ -n "$INGEST_TOKEN" ] && [ -n "$AFK_SERVER" ] || return 1
  SESSION_DIR=$1
}

# For `afk start`: a machine you are about to leave should get a session eventually,
# so wait for capacity rather than fail. Any other failure (unreachable, refused) is
# already explained by create_session and ends the command.
create_session_or_wait() {
  local waited=0 rc
  while true; do
    create_session; rc=$?
    if [ "$rc" = 0 ]; then
      return 0
    fi
    if [ "$rc" != 2 ]; then
      exit 1
    fi
    if [ "$waited" -ge "$CAPACITY_MAX_WAIT_SECONDS" ]; then
      die "gave up waiting for capacity after ${waited}s"
    fi
    log "retrying in ${CAPACITY_RETRY_SECONDS}s (Ctrl-C to give up)"
    sleep "$CAPACITY_RETRY_SECONDS"
    waited=$((waited + CAPACITY_RETRY_SECONDS))
  done
}

# Reads ~/.afk/current, written by the process that owns the session, without
# asking anyone whether it is still valid. Returns 1 if there is none.
read_current_file() {
  local file="$AFK_HOME/current"
  [ -f "$file" ] || return 1
  SESSION_ID=$(sed -n 's/^sessionId=//p' "$file")
  INGEST_TOKEN=$(sed -n 's/^ingestToken=//p' "$file")
  AFK_SERVER=$(sed -n 's/^server=//p' "$file")
  DASHBOARD_URL=$(sed -n 's/^dashboardUrl=//p' "$file")
  [ -n "$SESSION_ID" ] && [ -n "$INGEST_TOKEN" ] || return 1
  SESSION_DIR="$AFK_HOME/sessions/$SESSION_ID"
}

# Loads the session in ~/.afk/current for a joiner. Returns 1 if there is none, its
# owner is gone (a crashed owner leaves the file behind; its pid says so without a
# round trip), or the server says it is over, and 2 if the session is live but already
# has as many streams as the server allows.
load_current_session() {
  local summary summary_file status stream_count max_streams pid
  read_current_file || return 1
  pid=$(owner_pid)
  if [ -n "$pid" ] && ! pid_alive "$pid"; then
    log "ignoring stale session file (its owner, pid $pid, is gone)"
    remove_current_session_files
    return 1
  fi
  summary_file=$(mktemp "${TMPDIR:-/tmp}/afk-summary.XXXXXX")
  http_request -o "$summary_file" --connect-timeout 5 --max-time 10 \
    "$AFK_SERVER/api/sessions/$SESSION_ID" || { rm -f "$summary_file"; return 1; }
  summary=$(cat "$summary_file" 2>/dev/null)
  rm -f "$summary_file"
  status=$(json_get_string "$summary" status)
  if [ "$status" != "active" ]; then
    log "ignoring stale session file (session is ${status:-unknown})"
    remove_current_session_files
    return 1
  fi
  MAX_DURATION_SECONDS=$(json_get_number "$summary" maxDurationSeconds)
  : "${MAX_DURATION_SECONDS:=3600}"
  stream_count=$(json_get_number "$summary" streamCount)
  max_streams=$(json_get_number "$summary" maxStreams)
  if [ -n "$stream_count" ] && [ -n "$max_streams" ] && [ "$stream_count" -ge "$max_streams" ]; then
    log "session $SESSION_ID already has $max_streams streams, the server's limit"
    return 2
  fi
}

# How long before the cap `afk start` opens its successor: a quarter of the cap,
# between CHAIN_BEFORE_CAP_MIN_SECONDS and CHAIN_BEFORE_CAP_MAX_SECONDS.
chain_before_cap_seconds() {
  local before=$((MAX_DURATION_SECONDS / CHAIN_BEFORE_CAP_DIVISOR))
  [ "$before" -le "$CHAIN_BEFORE_CAP_MAX_SECONDS" ] || before=$CHAIN_BEFORE_CAP_MAX_SECONDS
  [ "$before" -ge "$CHAIN_BEFORE_CAP_MIN_SECONDS" ] || before=$CHAIN_BEFORE_CAP_MIN_SECONDS
  echo "$before"
}

# Continues the session in a new one (see docs/PROTOCOL.md, "Chaining"). The server
# ends the old session the moment its successor exists and answers 410 for it from
# then on, so the old queue is drained first: the sender is stopped, what it left is
# flushed, and only then is the successor created. The new URL is printed like the
# first one, `current` now names the new session (a joining `afk run` follows it, see
# reattach_to_current_session; an owning one, see follow_current_session), the
# sequence counters start over because sequences are per session, and a sender is
# started on the new queue. Run frames still in the old queue (an owning `afk run`'s
# sampler wrote them between the flush and the create) move to the new one: their
# sequences continue, which is all the server needs. Returns 1, with the old
# session's sender running again, when the flush did not get through or the server
# would not create the successor; the caller retries.
chain_session() {
  local old_id=$SESSION_ID old_token=$INGEST_TOKEN old_dir=$SESSION_DIR old_cap=$MAX_DURATION_SECONDS rc f
  stop_background_job "$SENDER_PID"
  flush_queue
  # A 410 means the old session is already over on the server (it hit the cap, or its
  # frame limit, or was ended after a long silence); nothing queued for it can be sent
  # any more, and the server still links a successor to an ended session.
  if [ "$(queue_count)" -gt 0 ] && [ "$HTTP_STATUS" != 410 ]; then
    log "could not send the last ${old_cap}s session's queue yet; will try again"
    sender_loop &
    SENDER_PID=$!
    return 1
  fi
  create_session "$old_id" "$old_token"; rc=$?
  if [ "$rc" != 0 ]; then
    sender_loop &
    SENDER_PID=$!
    return 1
  fi
  rm -f "$old_dir/response.json" "$old_dir/batch.ndjson" "$old_dir/gone"
  touch "$old_dir/done"
  for f in "$old_dir"/queue/*-run:*.ndjson; do
    [ -e "$f" ] && mv "$f" "$SESSION_DIR/queue/"
  done
  SEQ_SYSTEM=0
  SEQ_PROCESSES=0
  SAMPLE_TICK=0
  log "session $old_id reached its ${old_cap}s cap; continuing in session $SESSION_ID (max ${MAX_DURATION_SECONDS}s)"
  print_dashboard_url
  sender_loop &
  SENDER_PID=$!
}

# For an `afk run` that joined someone else's session and whose sends now get 410:
# the owner may have moved on to a successor and rewritten `current`. Re-reads it and,
# when it names a different session whose owner is alive, switches to it, leaving the
# old id in REATTACHED_FROM for the caller's log line. The queue stays where it is (its
# files do not care which session they go to) and so does the stream id: `run:<runId>`
# simply continues in the new session, its sequences with it. Returns 1 when there is
# nothing to re-attach to.
REATTACHED_FROM=""
reattach_to_current_session() {
  local old_id=$SESSION_ID old_token=$INGEST_TOKEN old_dir=$SESSION_DIR old_url=${DASHBOARD_URL:-} old_server=$AFK_SERVER
  [ "${SESSION_ROLE:-owner}" = joiner ] || return 1
  # The owner rewrites `current` right after the server has ended the old session; a
  # send can land in between, so look again after a moment.
  sleep "$SEND_INTERVAL_SECONDS"
  if read_current_file && [ "$SESSION_ID" != "$old_id" ] && pid_alive "$(owner_pid)"; then
    SESSION_DIR=$old_dir
    REATTACHED_FROM=$old_id
    return 0
  fi
  SESSION_ID=$old_id; INGEST_TOKEN=$old_token; SESSION_DIR=$old_dir
  DASHBOARD_URL=$old_url; AFK_SERVER=$old_server
  return 1
}

# For an `afk run` that owns its session: its system sampler runs in a subshell and
# chains there (chain_session rewrites `current`), so the run sampler and the main
# process, which write the run's frames, pick the successor up from `current` each
# time they look. Switches every session variable, the queue directory included, and
# returns 0 when `current` names a different session than before; when it is gone
# (the session is being ended) nothing changes and it returns 1.
follow_current_session() {
  local old_id=$SESSION_ID old_token=$INGEST_TOKEN old_dir=$SESSION_DIR old_url=${DASHBOARD_URL:-} old_server=$AFK_SERVER
  if read_current_file && [ "$SESSION_ID" != "$old_id" ]; then
    return 0
  fi
  SESSION_ID=$old_id; INGEST_TOKEN=$old_token; SESSION_DIR=$old_dir
  DASHBOARD_URL=$old_url; AFK_SERVER=$old_server
  return 1
}

end_session() {
  http_request -o /dev/null --connect-timeout 3 --max-time 5 -X POST \
    -K "$(auth_config_file)" \
    "$AFK_SERVER/api/sessions/$SESSION_ID/end" >/dev/null \
    || log "could not tell the server the session ended ($HTTP_ERROR); it will expire on its own"
  remove_current_session_files
  rm -f "$SESSION_DIR/response.json" "$SESSION_DIR/batch.ndjson"
  # Tells the startup cleanup this directory is finished with.
  touch "$SESSION_DIR/done"
}

# Removes session directories that ended (a `done` marker from end_session) more than
# a day ago, and ones that never ended, which a crash leaves behind, two days after
# the directory itself last changed (the sender touches it on every send).
cleanup_old_sessions() {
  local dir
  for dir in "$AFK_HOME"/sessions/*; do
    [ -d "$dir" ] || continue
    if [ -e "$dir/done" ]; then
      [ "$(file_age_seconds "$dir/done")" -gt "$SESSION_DONE_RETENTION_SECONDS" ] && rm -rf "$dir"
    else
      [ "$(file_age_seconds "$dir")" -gt "$SESSION_ORPHAN_RETENTION_SECONDS" ] && rm -rf "$dir"
    fi
  done
  return 0
}

# Frames a previous session could not send before its owner exited (the server was
# unreachable, or the owner was killed) are still in its queue, and the server accepts
# them until that session expires. Before a new session is created, every old queue
# whose session.json is still there is sent once, with the sender's batching: what the
# server accepts is deleted, a 410 or 404 means the session is over and its queue is
# dropped, and anything else leaves the rest for the next start or the sweep. One
# line is logged per session touched. A server that cannot be reached ends the whole
# pass, since the next queue would fail the same way and `afk start` is waiting.
resend_leftover_queues() {
  local dir count left rc server=$AFK_SERVER
  for dir in "$AFK_HOME"/sessions/*; do
    [ -d "$dir/queue" ] || continue
    read_session_record "$dir" || continue
    count=$(queue_count)
    [ "$count" -gt 0 ] || continue
    rc=0
    while [ "$(queue_count)" -gt 0 ]; do
      send_oldest_batch; rc=$?
      # An unknown session is parked as a rejection by the sender; here it means the
      # server has forgotten the session, the same as a 410.
      if [ "$rc" = 0 ] && [ "$HTTP_STATUS" = 404 ]; then
        rc=2
      fi
      [ "$rc" = 0 ] || break
    done
    left=$(queue_count)
    case "$rc" in
      0)
        log "sent $count frames left over from session $SESSION_ID" ;;
      2)
        rm -rf "$dir/queue"
        touch "$dir/done"
        log "session $SESSION_ID is over on the server; dropped its $left unsent frames" ;;
      *)
        log "could not send the $left frames left over from session $SESSION_ID (${HTTP_ERROR:-HTTP $HTTP_STATUS}); they stay for the next start"
        break ;;
    esac
  done
  AFK_SERVER=$server
  return 0
}

# ---------------------------------------------------------------------------
# sampler: runs collectors on their interval, writes one file per frame into queue/
# ---------------------------------------------------------------------------

SEQ_SYSTEM=0
SEQ_PROCESSES=0
# Counts sampler ticks (one per SAMPLE_INTERVAL_SECONDS) so slower collectors can run
# every Nth tick; the first tick runs every collector so a session starts with each stream.
SAMPLE_TICK=0

# One frame per file, named `<sequence>-<stream>.ndjson` so that `queue/*.ndjson` in
# name order is sequence order within every stream, which is the only order the server
# cares about (it de-duplicates per stream by sequence; a frame arriving after a higher
# sequence of its stream would be dropped). The frame is written to a hidden temp file
# and renamed into place: rename is atomic, so the sender never sees a partial file,
# and with no shared spool file there is nothing for the sampler and sender to race
# on (macOS has no flock).
emit_frame() { # stream collector sequence data-json
  local name temp
  name=$(printf '%010d-%s.ndjson' "$3" "$1")
  temp="$SESSION_DIR/queue/.$name.tmp"
  printf '{"stream":"%s","collector":"%s","sequence":%d,"timestamp":%d,"data":%s}\n' \
    "$1" "$2" "$3" "$(now_seconds)" "$4" > "$temp" && mv "$temp" "$SESSION_DIR/queue/$name"
}

# True on the ticks a collector with this interval (in seconds) is due.
due_every() { # interval-seconds
  [ $(( (SAMPLE_TICK - 1) % ($1 / SAMPLE_INTERVAL_SECONDS) )) -eq 0 ]
}

sample_once() {
  SAMPLE_TICK=$((SAMPLE_TICK + 1))
  SEQ_SYSTEM=$((SEQ_SYSTEM + 1))
  emit_frame system system "$SEQ_SYSTEM" "$(collect_system)"
  if due_every "$PROCESSES_INTERVAL_SECONDS"; then
    SEQ_PROCESSES=$((SEQ_PROCESSES + 1))
    emit_frame processes processes "$SEQ_PROCESSES" "$(collect_processes)"
  fi
}

# ---------------------------------------------------------------------------
# sender: ships the oldest queued frames as one batch per request, deletes them
# on success, backs off and retries forever on failure
# ---------------------------------------------------------------------------

# Sends up to SEND_MAX_FILES_PER_BATCH oldest queue files (one frame each) as one request.
# Returns 0 on success (files deleted), 1 on a retryable failure, 2 when the session is
# over on the server (410), and 3 when the server will no longer talk to this client
# version (426). The queue is kept on 2 and 3.
send_oldest_batch() {
  local batch="$SESSION_DIR/batch.ndjson" files="" count=0 f status
  for f in "$SESSION_DIR"/queue/*.ndjson; do
    [ -e "$f" ] || break
    files="$files $f"
    count=$((count + 1))
    [ "$count" -ge "$SEND_MAX_FILES_PER_BATCH" ] && break
  done
  [ "$count" -gt 0 ] || return 0

  # shellcheck disable=SC2086
  cat $files > "$batch"
  http_request -o "$SESSION_DIR/response.json" \
    --connect-timeout 5 --max-time 20 \
    -K "$(auth_config_file)" -H 'Content-Type: application/x-ndjson' \
    --data-binary "@$batch" "$AFK_SERVER/api/sessions/$SESSION_ID/frames"
  status=$HTTP_STATUS

  case "$status" in
    2*)
      # shellcheck disable=SC2086
      rm -f $files "$batch"
      return 0 ;;
    410)
      log "server closed the session ($(cat "$SESSION_DIR/response.json" 2>/dev/null))"
      return 2 ;;
    426)
      # The server stopped talking to this client version mid-session: stop, keep the
      # queue, and print the hint on how to update.
      log_upgrade_required "$(cat "$SESSION_DIR/response.json" 2>/dev/null)"
      return 3 ;;
    400|401|404|413|422)
      # The server will never accept this batch; keep it out of the way so we don't stall.
      # TODO(hardening): decide whether to keep these for debugging or drop them.
      log "server rejected batch with HTTP $status: $(cat "$SESSION_DIR/response.json" 2>/dev/null)"
      mkdir -p "$SESSION_DIR/rejected"
      # shellcheck disable=SC2086
      mv $files "$SESSION_DIR/rejected/"
      return 0 ;;
    *)
      return 1 ;;
  esac
}

# Drops the oldest queued frames until the queue is back under SPOOL_MAX_BYTES. Only
# an outage grows the queue, so the sender calls this after every failed send. Frames
# dropped here are gone for good, so the session keeps a running count of them in
# `dropped` (frames and bytes, for `afk status`); the log line is rate limited because
# a long outage would otherwise print one per retry, and carries the running total.
SPOOL_DROPPED_BYTES=0
SPOOL_DROPPED_FRAMES=0
SPOOL_DROP_LOGGED_AT=0
DROPPED_RECORD_NAME=dropped

enforce_spool_cap() {
  local total f size now frames=0 bytes=0
  total=$(queue_bytes)
  [ "$total" -gt "$SPOOL_MAX_BYTES" ] || return 0
  for f in "$SESSION_DIR"/queue/*.ndjson; do
    [ -e "$f" ] || break
    [ "$total" -gt "$SPOOL_MAX_BYTES" ] || break
    size=$(file_size "$f")
    rm -f "$f"
    total=$((total - size))
    frames=$((frames + 1))
    bytes=$((bytes + size))
  done
  SPOOL_DROPPED_FRAMES=$((SPOOL_DROPPED_FRAMES + frames))
  SPOOL_DROPPED_BYTES=$((SPOOL_DROPPED_BYTES + bytes))
  record_dropped "$SESSION_DIR" "$frames" "$bytes"
  now=$(now_seconds)
  if [ $((now - SPOOL_DROP_LOGGED_AT)) -ge "$SPOOL_DROP_LOG_INTERVAL_SECONDS" ]; then
    log "queue is over ${SPOOL_MAX_BYTES} bytes; dropped the oldest ${SPOOL_DROPPED_FRAMES} frames (${SPOOL_DROPPED_BYTES} bytes), $(dropped_frames "$SESSION_DIR") frames since the session started"
    SPOOL_DROPPED_BYTES=0
    SPOOL_DROPPED_FRAMES=0
    SPOOL_DROP_LOGGED_AT=$now
  fi
}

# The `dropped` record is one line, `<frames> <bytes>`, added to on every enforcement
# (the sender that drops and the `afk status` that reports are different processes).
record_dropped() { # session-dir frames bytes
  local frames bytes
  frames=$(dropped_frames "$1")
  bytes=$(dropped_bytes "$1")
  printf '%d %d\n' $((frames + $2)) $((bytes + $3)) > "$1/$DROPPED_RECORD_NAME"
}
# Both read 0 until the first enforcement writes the record (awk is given the file
# itself, and would not reach END on a missing one).
dropped_frames() { # session-dir
  [ -e "$1/$DROPPED_RECORD_NAME" ] || { echo 0; return 0; }
  awk '{ f += $1 } END { print f + 0 }' "$1/$DROPPED_RECORD_NAME"
}
dropped_bytes() { # session-dir
  [ -e "$1/$DROPPED_RECORD_NAME" ] || { echo 0; return 0; }
  awk '{ b += $2 } END { print b + 0 }' "$1/$DROPPED_RECORD_NAME"
}

# The session being over on the server (410) ends the sender, and with it the sampler,
# except that a joiner follows its owner to a successor session, and an `afk start`
# owner is told (a `gone` marker, see system_sampler_loop) so it can open one itself.
sender_loop() {
  local backoff=1 rc
  while true; do
    send_oldest_batch; rc=$?
    case "$rc" in
      0) backoff=1; sleep "$SEND_INTERVAL_SECONDS" ;;
      1) enforce_spool_cap
         log "send failed (${HTTP_ERROR:-HTTP $HTTP_STATUS}), retrying in ${backoff}s (queued: $(queue_count) frames)"
         sleep "$backoff"
         backoff=$((backoff * 2)); [ "$backoff" -gt "$SEND_MAX_BACKOFF_SECONDS" ] && backoff=$SEND_MAX_BACKOFF_SECONDS ;;
      2)
        if reattach_to_current_session; then
          log "session $REATTACHED_FROM ended; continuing in session $SESSION_ID"
          backoff=1
          continue
        fi
        if [ "${SESSION_CHAINING:-0}" = 1 ]; then
          touch "$SESSION_DIR/gone"
        else
          touch "$SESSION_DIR/stop"
        fi
        return ;;
      3) touch "$SESSION_DIR/stop"; return ;;
    esac
  done
}

# Final attempt to drain the queue when the session ends. Best effort, short timeout.
flush_queue() {
  while [ "$(queue_count)" -gt 0 ]; do
    send_oldest_batch || break
  done
}

# ---------------------------------------------------------------------------
# commands
# ---------------------------------------------------------------------------

# Samples machine health until the session is stopped (by the server via the
# sender, or by hitting the cap). Runs in the foreground for `afk start` and in a
# background subshell for an `afk run` that had to start its own session; both set
# SESSION_CHAINING so the loop hands over to a successor session before the cap (see
# chain_session; the run's own frames follow through follow_current_session).
system_sampler_loop() {
  local started now deadline chain_at chain_attempted_at=0
  started=$(now_seconds)
  deadline=$started
  chain_at=$((MAX_DURATION_SECONDS - $(chain_before_cap_seconds)))
  while [ ! -e "$SESSION_DIR/stop" ]; do
    now=$(now_seconds)
    # Chain before the cap, or as soon as the server has closed the session under us
    # (`gone`, left by the sender on a 410) unless it did so almost at once. A chain
    # that fails is retried every CHAIN_RETRY_SECONDS until the cap stops the loop.
    if [ "${SESSION_CHAINING:-0}" = 1 ] && [ $((now - chain_attempted_at)) -ge "$CHAIN_RETRY_SECONDS" ] \
      && { [ $((now - started)) -ge "$chain_at" ] \
        || { [ -e "$SESSION_DIR/gone" ] && [ $((now - started)) -ge "$CHAIN_MIN_SESSION_SECONDS" ]; }; }; then
      chain_attempted_at=$now
      if chain_session; then
        started=$(now_seconds)
        now=$started
        chain_at=$((MAX_DURATION_SECONDS - $(chain_before_cap_seconds)))
        chain_attempted_at=0
      fi
    fi
    if [ $((now - started)) -ge "$MAX_DURATION_SECONDS" ]; then
      log "reached the maximum session length"
      touch "$SESSION_DIR/stop"
      break
    fi
    sample_once
    # Ticks are scheduled against a deadline that advances by the interval, rather
    # than sleeping a fixed interval after the collectors, so their runtime does not
    # push every tick later than the last. Stock macOS has no sub-second clock (no
    # `date +%N`), so a tick that finishes early sleeps to the next whole second
    # and one that finishes late is followed by the next tick straight away: single
    # gaps vary by the collectors' runtime, but the average rate stays at 1 Hz. A
    # deadline more than SAMPLE_MAX_CATCHUP_SECONDS behind (the machine slept) is
    # re-based on the current time instead of being caught up in a burst.
    deadline=$((deadline + SAMPLE_INTERVAL_SECONDS))
    now=$(now_seconds)
    if [ "$now" -lt "$deadline" ]; then
      sleep $((deadline - now))
    elif [ $((now - deadline)) -gt "$SAMPLE_MAX_CATCHUP_SECONDS" ]; then
      deadline=$now
    fi
  done
}

# ---------------------------------------------------------------------------
# qr code: the dashboard URL, drawn for a phone camera. Rendered by the server
# (bash has no QR library; see docs/PROTOCOL.md) with the URL printed under it.
# ---------------------------------------------------------------------------

# Whether stdout is a terminal; the tests override this after sourcing the script.
stdout_is_terminal() { [ -t 1 ]; }

# ---------------------------------------------------------------------------
# updates
#
# The create response carries `latestClientVersion`, the version of the client the
# server itself serves at /cli/afk. A copy that is behind says so, and `afk start` on
# a terminal offers to run the installer. Only a 426 (log_upgrade_required) is a
# refusal; this is advice, and a session never depends on it.
# ---------------------------------------------------------------------------

# The question needs someone at the keyboard: stdin to read the answer from and
# stderr, where it is asked, both terminals. Tests replace this.
can_prompt() { [ -t 0 ] && [ -t 2 ]; }

# After a session create: say when the server serves a newer client than this one and,
# with `prompt` (`afk start`, on a terminal, unless AFK_NO_UPDATE_PROMPT=1), ask whether
# to run the installer now. No is the default and the question waits at most
# UPDATE_PROMPT_TIMEOUT_SECONDS, so a start nobody is watching is barely delayed; a
# failed update is logged and the session carries on. The new copy is only picked up
# by the next `afk start`: this process keeps running the code it loaded, and the
# session it just created is not disturbed.
check_client_update() { # [prompt]
  local answer=""
  if [ -z "${LATEST_CLIENT_VERSION:-}" ] || ! version_lt "$AFK_VERSION" "$LATEST_CLIENT_VERSION"; then
    return 0
  fi
  log "afk $LATEST_CLIENT_VERSION is available (this is $AFK_VERSION). Update with: curl -fsSL $AFK_SERVER/install | sh"
  if [ "${1:-}" != prompt ] || [ "${AFK_NO_UPDATE_PROMPT:-0}" = 1 ] || ! can_prompt; then
    return 0
  fi
  printf 'afk: update now? [y/N] ' >&2
  # read fails on the timeout (and on end of input); either is a no, with the cursor
  # still on the question's line.
  read -r -t "$UPDATE_PROMPT_TIMEOUT_SECONDS" answer || printf '\n' >&2
  case "$answer" in
    y|Y|yes|Yes|YES) ;;
    *)
      log "not updating (run 'afk update' any time)"
      return 0 ;;
  esac
  if run_installer; then
    log "installed afk $(installed_client_version "$INSTALLED_CLIENT_PATH") at $INSTALLED_CLIENT_PATH; it takes effect on the next afk start (this session keeps running $AFK_VERSION)"
  else
    log "update failed; this session carries on with afk $AFK_VERSION"
  fi
}

# The directory this copy runs from, for the installer to replace it in place.
self_directory() { (cd "$(dirname "$0")" && pwd); }

# The AFK_VERSION line of an installed copy, the way the server reads it too.
installed_client_version() { # path
  sed -n 's/^AFK_VERSION="\(.*\)"$/\1/p' "$1" 2>/dev/null
}

# Downloads the installer from $AFK_SERVER and runs it: the same `curl | sh` the 426
# hint prints, installing over this copy unless AFK_INSTALL_DIR names another directory
# (the installer's own default is ~/.local/bin). The download goes to a file first so
# a failed download fails here instead of feeding sh an empty script; over https the
# same downgrade guard as the installer's own fetches applies. Its output goes to
# stderr, keeping stdout for the dashboard URL, and its stdin is closed so it cannot
# read the terminal. Leaves the installed path in INSTALLED_CLIENT_PATH.
run_installer() {
  local installer rc
  INSTALLED_CLIENT_PATH="${AFK_INSTALL_DIR:-$(self_directory)}/afk"
  installer=$(mktemp "${TMPDIR:-/tmp}/afk-installer.XXXXXX")
  case "$AFK_SERVER" in
    https://*) curl -fsSL --proto '=https' --tlsv1.2 -o "$installer" "$AFK_SERVER/install" ;;
    *) curl -fsSL -o "$installer" "$AFK_SERVER/install" ;;
  esac || {
    rm -f "$installer"
    log "could not download $AFK_SERVER/install"
    return 1
  }
  AFK_INSTALL_DIR="${INSTALLED_CLIENT_PATH%/afk}" sh "$installer" >&2 </dev/null; rc=$?
  rm -f "$installer"
  return "$rc"
}

# `afk update`: run the installer whatever the server said, and show what changed.
cmd_update() {
  local after
  log "this is afk $AFK_VERSION; updating from $AFK_SERVER"
  run_installer || die "update failed; nothing was changed"
  after=$(installed_client_version "$INSTALLED_CLIENT_PATH")
  if [ "$after" = "$AFK_VERSION" ]; then
    log "afk $AFK_VERSION is the latest; reinstalled at $INSTALLED_CLIENT_PATH"
  else
    log "afk $AFK_VERSION -> ${after:-?} at $INSTALLED_CLIENT_PATH"
  fi
}

# `afk version [--check]`: this copy's version and, with --check, the one the server
# serves (`client.version` of /api/version), with a hint when this copy is behind.
cmd_version() {
  local file response latest
  printf 'afk %s\n' "$AFK_VERSION"
  [ "${1:-}" = "--check" ] || return 0
  file=$(mktemp "${TMPDIR:-/tmp}/afk-version.XXXXXX")
  http_request -o "$file" --connect-timeout 5 --max-time 10 "$AFK_SERVER/api/version" || {
    rm -f "$file"
    die "could not reach $AFK_SERVER: $HTTP_ERROR"
  }
  response=$(cat "$file" 2>/dev/null)
  rm -f "$file"
  [ "$HTTP_STATUS" = 200 ] || die "$AFK_SERVER/api/version answered HTTP $HTTP_STATUS"
  latest=$(json_get_string "$(json_get_object "$response" client)" version)
  if [ -z "$latest" ]; then
    die "$AFK_SERVER does not say which client it serves (an older server, or one without the client)"
  fi
  printf 'latest %s (%s)\n' "$latest" "$AFK_SERVER"
  if version_lt "$AFK_VERSION" "$latest"; then
    log "update with: afk update"
  fi
}

# Fetches the current session's QR code and prints it, block plus URL line, exactly as
# the server sent it. Prints nothing and returns 1 unless the server answered 200.
fetch_qr() {
  local file="$AFK_HOME/qr-$$.txt" status
  status=$(curl -sS -o "$file" -w '%{http_code}' --connect-timeout 3 --max-time 5 \
    -K "$(auth_config_file)" -H "X-Afk-Client: bash/$AFK_VERSION" \
    "$AFK_SERVER/api/sessions/$SESSION_ID/qr" 2>/dev/null) || status=000
  # Only print what looks like a QR code: an older server answers unknown /api paths
  # with the dashboard's HTML and a 200, and that must never be dumped on the terminal.
  if [ "$status" = 200 ] && [ "$(head -c 2 "$file" | od -An -tx1 | tr -d ' \n')" = "e296" ]; then
    cat "$file"
    rm -f "$file"
    return 0
  fi
  rm -f "$file"
  return 1
}

# Prints a session's dashboard URL, exactly once: under its QR code when the code would
# be seen (stdout is a terminal, --no-qr or AFK_NO_QR=1 did not turn it off, and the
# server rendered one; the server's text block ends with the URL), on a line of its
# own otherwise. A pipe or a log file gets the URL alone, and a failed fetch costs
# nothing but the QR; the session never depends on it.
print_dashboard_url() {
  printf '\n'
  if [ "${AFK_NO_QR:-0}" != 1 ] && stdout_is_terminal && fetch_qr; then
    printf '\n'
    return 0
  fi
  printf '  %s\n\n' "$DASHBOARD_URL"
}

cmd_qr() {
  local rc
  load_current_session; rc=$?
  # 2 means the session is live but full of streams, which is no reason not to show its URL.
  if [ "$rc" = 1 ]; then
    die "no active session on this machine (start one with 'afk start')"
  fi
  fetch_qr || die "could not fetch the QR code from $AFK_SERVER; the dashboard is at $DASHBOARD_URL"
}

# `afk start` while another one runs on this machine: refuse, naming that session,
# unless --force, which asks the old owner to finish (SIGTERM, the same as `afk stop`:
# it flushes its queue and ends its session) and waits for it to remove `current`.
# A session whose owner is gone, or which the server says is over, is cleared by
# load_current_session and does not count.
guard_running_session() { # force
  local rc pid waited=0 server=$AFK_SERVER
  load_current_session; rc=$?
  # read_current_file switched to the running session's server; the new session goes
  # to the one this command was given.
  AFK_SERVER=$server
  if [ "$rc" = 1 ]; then
    return 0
  fi
  pid=$(owner_pid)
  if [ "$1" != 1 ]; then
    log "error: a session is already running on this machine (pid ${pid:-?}): $DASHBOARD_URL"
    log "use 'afk status' to see it, 'afk stop' to end it, or 'afk start --force' to take it over"
    exit 1
  fi
  log "taking over: asking pid $pid to end session $SESSION_ID"
  kill -TERM "$pid" 2>/dev/null || die "could not signal pid $pid"
  while [ -e "$AFK_HOME/current" ] && pid_alive "$pid" && [ "$waited" -lt "$FORCE_TAKEOVER_WAIT_SECONDS" ]; do
    sleep 1
    waited=$((waited + 1))
  done
  if pid_alive "$pid"; then
    die "pid $pid has not ended session $SESSION_ID after ${FORCE_TAKEOVER_WAIT_SECONDS}s; stop it yourself"
  fi
  # An owner that died without running its exit trap leaves the files behind.
  remove_current_session_files
}

cmd_start() {
  local arg force=0
  for arg in "$@"; do
    case "$arg" in
      --no-qr) AFK_NO_QR=1 ;;
      --force) force=1 ;;
      *) die "unknown option: $arg (try 'afk help')" ;;
    esac
  done
  check_platform
  guard_running_session "$force"
  cleanup_old_sessions
  resend_leftover_queues
  gather_host_info
  create_session_or_wait
  check_client_update prompt
  log "session $SESSION_ID started (max ${MAX_DURATION_SECONDS}s). Ctrl-C to end."
  print_dashboard_url

  sender_loop &
  SENDER_PID=$!

  # One Ctrl-C (or `afk stop`) sends what is still queued and tells the server; a
  # second one during that gives up on the flush and exits at once (the EXIT trap
  # set by create_session still removes the owner's state files).
  finish() {
    trap abandon INT TERM
    log "ending session... (Ctrl-C again to skip sending what is still queued)"
    stop_background_job "$SENDER_PID"
    flush_queue
    end_session
    log "session ended. Dashboard stays available at $DASHBOARD_URL"
    exit 0
  }
  # shellcheck disable=SC2329,SC2317 # invoked through the trap finish sets (2317 is the older code)
  abandon() {
    trap - INT TERM
    log "interrupted again; leaving $(queue_count) queued frames unsent in $SESSION_DIR"
    exit 130
  }
  trap finish INT TERM

  # Only `afk start` chains: its sampler runs in this shell and can restart the sender.
  SESSION_CHAINING=1
  system_sampler_loop
  finish
}

# Replaces this process with the command, with the caller's umask rather than this
# script's private one, for the cases where `afk run` cannot get a session.
run_without_telemetry() { # command args...
  log "running without telemetry"
  umask "$ORIGINAL_UMASK"
  exec "$@"
}

cmd_run() {
  if [ "${1:-}" = "--no-qr" ]; then
    AFK_NO_QR=1
    shift
  fi
  [ "${1:-}" = "--" ] && shift
  [ $# -gt 0 ] || die "usage: afk run -- <command> [args...]"
  check_platform

  # Telemetry must never get in the way of the command itself: if the server is full,
  # unreachable, refuses this client, or the session already has its maximum number
  # of streams, just run the command.
  local owner=0 joined
  load_current_session; joined=$?
  case "$joined" in
    0)
      log "joining session $SESSION_ID"
      # The sender follows the owner to a successor session when this one ends.
      SESSION_ROLE=joiner ;;
    1)
      owner=1
      gather_host_info
      if ! create_session; then
        run_without_telemetry "$@"
      fi
      log "no session running here; started $SESSION_ID with machine telemetry for the length of this command"
      check_client_update ;;
    *) run_without_telemetry "$@" ;;
  esac

  RUN_ID=$(random_id)
  RUN_STARTED=$(now_seconds)
  RUN_COMMAND_JSON=$(json_string "$*" | cut -c1-200)
  RUN_DIR="$AFK_HOME/sessions/$SESSION_ID/runs/$RUN_ID"
  mkdir -p "$RUN_DIR"
  # For `afk status`, which lists the runs still going.
  printf '%s\n' "$*" | cut -c "1-$RUN_COMMAND_MAX_CHARS" > "$RUN_DIR/command"
  if [ "$owner" = 0 ]; then
    # A joiner keeps its own spool so it never races the owner's sender.
    SESSION_DIR="$RUN_DIR"
    mkdir -p "$SESSION_DIR/queue"
  fi
  # A joiner's URL was already printed, QR and all, by the `afk start` that owns it.
  if [ "$owner" = 1 ]; then
    print_dashboard_url
  else
    printf '\n  %s\n\n' "$DASHBOARD_URL"
  fi

  sender_loop &
  SENDER_PID=$!
  SYSTEM_PID=""
  if [ "$owner" = 1 ]; then
    # The sampler chains before the cap like `afk start`'s, from its subshell: it
    # stops this sender, creates the successor, rewrites `current`, and starts a
    # sender of its own under itself. The run sampler and this process follow
    # `current` (follow_current_session) so the run's frames go to the successor.
    SESSION_CHAINING=1
    system_sampler_loop &
    SYSTEM_PID=$!
  fi
  run_sampler_loop &
  RUN_SAMPLER_PID=$!

  # The command runs in the foreground so Ctrl-C and stdin behave as usual. Bash
  # would normally exit when a foreground child dies of SIGINT; trapping it lets us
  # still report the exit. The sh wrapper records the pid the sampler should watch,
  # then gives the command the caller's umask back (this script's own is private).
  # TODO(run): tee and split add a little latency to the final byte counts; a short pause covers it.
  trap ':' INT TERM
  sh -c 'echo $$ > "$1"; umask "$2"; shift 2; exec "$@"' sh "$RUN_DIR/pid" "$ORIGINAL_UMASK" "$@" \
    > >(tee >(run_capture_sink stdout)) 2> >(tee >(run_capture_sink stderr) >&2)
  EXIT_CODE=$?
  trap - INT TERM

  stop_background_job "$RUN_SAMPLER_PID"
  sleep 0.3
  # The system sampler goes first so that `current` holds still: if it chained during
  # the command, the final frame and the flush below go to the successor, whose
  # sender (started under the sampler) died with it; the sender started here was
  # stopped by the chain.
  stop_background_job "$SYSTEM_PID"
  if [ "$owner" = 1 ] && follow_current_session; then
    SENDER_PID=""
  fi
  local seq
  seq=$(( $(cat "$RUN_DIR/seq" 2>/dev/null || echo 0) + 1 ))
  # Only a failure ships any output, and only its tail (empty for exit code 0). The
  # captured output has served its purpose once the final frame is built.
  emit_frame "run:$RUN_ID" run "$seq" "$(collect_run exited "$EXIT_CODE" "$(run_output_tail "$EXIT_CODE")")"
  remove_run_captures
  log "command exited with status $EXIT_CODE"

  stop_background_job "$SENDER_PID"
  flush_queue
  # A joiner whose owner moved on to a successor during the command (the sender in the
  # background followed it; this shell still has the old session) sends what is left,
  # the final frame included, to the successor.
  if [ "$HTTP_STATUS" = 410 ] && reattach_to_current_session; then
    log "session $REATTACHED_FROM ended; sending the last frames of this run to session $SESSION_ID"
    flush_queue
  fi
  if [ "$owner" = 1 ]; then
    end_session
    log "session ended. Dashboard stays available at $DASHBOARD_URL"
  fi
  exit "$EXIT_CODE"
}

# Reports on the session in ~/.afk/current from local state only: no network, so it
# answers instantly even when the server is unreachable. The queue counted is the
# owner's plus those of the `afk run`s that joined (each keeps its own under
# runs/<runId>/), and every run whose command is still going is listed with the
# command's pid.
cmd_status() {
  local pid owner dir total_dropped_frames total_dropped_bytes run_dir run_pid
  if ! read_current_file; then
    printf 'no session running on this machine\n'
    exit 1
  fi
  pid=$(owner_pid)
  if [ -z "$pid" ]; then
    owner="unknown (no owner.pid)"
  elif pid_alive "$pid"; then
    owner="pid $pid, running"
  else
    owner="pid $pid, not running (stale; afk stop clears it)"
  fi
  printf 'session    %s\ndashboard  %s\nowner      %s\nqueue      %s frames, %s bytes\n' \
    "$SESSION_ID" "$DASHBOARD_URL" "$owner" \
    "$(queue_count "$SESSION_DIR/queue" "$SESSION_DIR"/runs/*/queue)" \
    "$(queue_bytes "$SESSION_DIR/queue" "$SESSION_DIR"/runs/*/queue)"
  # Frames the queue cap threw away, the owner's and the joined runs' together.
  total_dropped_frames=0; total_dropped_bytes=0
  for dir in "$SESSION_DIR" "$SESSION_DIR"/runs/*; do
    total_dropped_frames=$((total_dropped_frames + $(dropped_frames "$dir")))
    total_dropped_bytes=$((total_dropped_bytes + $(dropped_bytes "$dir")))
  done
  if [ "$total_dropped_frames" -gt 0 ]; then
    printf 'dropped    %s frames, %s bytes (queue over %s bytes while the server was unreachable)\n' \
      "$total_dropped_frames" "$total_dropped_bytes" "$SPOOL_MAX_BYTES"
  fi
  for run_dir in "$SESSION_DIR"/runs/*; do
    run_pid=$(cat "$run_dir/pid" 2>/dev/null)
    pid_alive "$run_pid" || continue
    printf 'run        pid %s, running: %s\n' "$run_pid" "$(cat "$run_dir/command" 2>/dev/null)"
  done
}

# Ends the session by asking its owner (the `afk start` or owning `afk run` process)
# to finish, the same as a Ctrl-C there: it flushes what it can and tells the server.
# The owner reacts within about a second (its sender's request in flight is cut short,
# see stop_background_job); the flush itself can still take one request's timeout
# against a server that accepts connections but never answers, and a second `afk stop`
# skips it.
cmd_stop() {
  local pid
  if ! read_current_file; then
    log "no session running on this machine"
    exit 1
  fi
  pid=$(owner_pid)
  if pid_alive "$pid"; then
    kill -TERM "$pid" || die "could not signal pid $pid"
    log "asked pid $pid to end session $SESSION_ID"
  else
    log "session $SESSION_ID has no running owner${pid:+ (pid $pid is gone)}; clearing its stale state"
    remove_current_session_files
    exit 1
  fi
}

# The header comment from the "afk —" line to the first blank line, without the license
# notice above it.
usage() {
  awk '/^# afk /{ printing = 1 } printing && /^$/{ exit } printing' "$0" | sed 's/^# \{0,1\}//'
}

main() {
  case "${1:-}" in
    start)   shift; cmd_start "$@" ;;
    run)     shift; cmd_run "$@" ;;
    status)  cmd_status ;;
    stop)    cmd_stop ;;
    qr)      cmd_qr ;;
    update)  cmd_update ;;
    version) shift; cmd_version "$@" ;;
    -h|--help|help|"") usage ;;
    *)       die "unknown command: $1 (try 'afk help')" ;;
  esac
}

# Sourcing the script with AFK_SOURCED=1 loads the functions without running anything,
# which is how the tests exercise them.
if [ "${AFK_SOURCED:-0}" != 1 ]; then
  main "$@"
fi
