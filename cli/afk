#!/bin/bash
#
# afk — away-from-keyboard telemetry for your machine.
#
# Starts a session, samples machine health once a second (and the busiest processes
# every few seconds), and streams it to an afk server so you can watch a shareable
# dashboard from your phone. Designed to be downloaded, read, and run: plain bash 3.2
# (what macOS ships), curl, and stock macOS tools only. No jq, no python.
#
# Usage:
#   afk start [--no-qr]  start a session in the foreground (Ctrl-C to end it)
#   afk run [--no-qr] -- <cmd>
#                        run a command and report its progress; joins the session
#                        started by `afk start` if one is running on this machine,
#                        otherwise starts one (with machine telemetry) for the
#                        lifetime of the command
#   afk status           show the session running on this machine and its queue
#   afk stop             end that session (asks the `afk start` process to finish)
#   afk qr               print the current session's dashboard URL as a QR code again
#   afk version
#
# The dashboard URL is printed with a QR code under it when stdout is a terminal, so
# you can point a phone at the screen instead of typing it; --no-qr skips that.
#
# The server caps a session (an hour by default). Shortly before that `afk start`
# opens a successor session that continues the old one and prints its URL (and QR);
# the two dashboards link to each other. An `afk run` that joined the old session
# follows along on its own.
#
# Environment:
#   AFK_SERVER           server origin, default https://afk.osv.im, or the server this
#                        copy was installed from (curl -fsSL <origin>/install | sh)
#   AFK_HOME             state directory, default ~/.afk
#   AFK_SPOOL_MAX_BYTES  cap on queued frames on disk, default 50 MiB; oldest dropped past it
#   AFK_NO_QR            set to 1 to never print the QR code (same as --no-qr)
#   AFK_RUN_TAIL_LINES   how many of the last lines of stdout and stderr a failed `afk run`
#                        reports, default 20; 0 sends no output at all (exit 0 never sends any)
#
# Layout of ~/.afk:
#   current                        the active session (id, token, server) so other
#                                  afk processes can join it
#   owner.pid                      pid of the process that created it; a dead owner
#                                  marks `current` stale without asking the server
#   sessions/<id>/queue/<seq>-<stream>.ndjson
#                                  one sampled frame per file, waiting to be sent; a
#                                  batch is the oldest files concatenated, deleted on 2xx
#   sessions/<id>/done             written when the session ended (or was continued by
#                                  a successor); `afk start` removes session
#                                  directories a day after this (two days after their
#                                  last change if it is missing)
#   sessions/<id>/runs/<runId>/    an `afk run`: captured stdout/stderr, pid, and (when it
#                                  joined an existing session) its own queue
#
# The client is deliberately dumb: it ships raw measurements and lets the server
# decide what is normal. That way the server can improve without anyone re-downloading
# this script.

set -u

# Client version (semver, bumped on every release) and the protocol version it speaks
# (bumped only for an incompatible wire change). See docs/VERSIONING.md.
AFK_VERSION="0.2.0"
AFK_PROTOCOL_VERSION=1
# The installer (`curl -fsSL <origin>/install | sh`) rewrites the next line so a copy
# installed from a self-hosted server defaults to that server; the marker comment is
# what it matches on. Keep the hosted default here in the repo.
AFK_SERVER="${AFK_SERVER:-https://afk.osv.im}" # afk-install: default server
AFK_HOME="${AFK_HOME:-$HOME/.afk}"
# Where the upgrade hint says to fetch a newer copy of this script from.
AFK_DOWNLOAD_URL="https://raw.githubusercontent.com/vaskevich/afk/main/cli/afk"

# The sampler ticks once per SAMPLE_INTERVAL_SECONDS; each collector runs on every tick
# or, for the slower ones, every N seconds (must be a multiple of the tick).
SAMPLE_INTERVAL_SECONDS=1
# A sampler further behind schedule than this (the machine slept) skips ahead instead
# of catching up tick by tick; see system_sampler_loop.
SAMPLE_MAX_CATCHUP_SECONDS=2
PROCESSES_INTERVAL_SECONDS=5
# How many of the busiest processes a processes frame carries (PROCESSES_TOP_MAX in shared).
PROCESSES_TOP_MAX=10
# Full executable paths are cut to this many characters (PROCESS_COMMAND_MAX_LENGTH in shared).
PROCESS_COMMAND_MAX_LENGTH=512
# A failed `afk run` puts the last AFK_RUN_TAIL_LINES lines of its stdout and stderr on its
# final frame, at most RUN_TAIL_MAX_LINES (the same name in shared), each cut to
# RUN_TAIL_MAX_LINE_CHARS bytes. 0 is the privacy switch: no output leaves the machine.
RUN_TAIL_MAX_LINES=20
RUN_TAIL_MAX_LINE_CHARS=200
AFK_RUN_TAIL_LINES="${AFK_RUN_TAIL_LINES:-$RUN_TAIL_MAX_LINES}"
SEND_INTERVAL_SECONDS=1
SEND_MAX_BACKOFF_SECONDS=30
SEND_MAX_FILES_PER_BATCH=200
# The queue is capped so a laptop that is offline overnight cannot fill its disk: past
# this many bytes the oldest frames are dropped (and a line logged, at most this often).
SPOOL_MAX_BYTES="${AFK_SPOOL_MAX_BYTES:-52428800}"
SPOOL_DROP_LOG_INTERVAL_SECONDS=60

# When the server is at capacity, `afk start` waits and retries this often, for at most this long.
CAPACITY_RETRY_SECONDS=30
CAPACITY_MAX_WAIT_SECONDS=600

# `afk start` opens its successor session this long before the server's cap, so the
# old session's last frames are sent while it still accepts them: 30 s for the default
# hour, a quarter of a shorter cap (tests and local runs use caps of seconds), never
# under 2 s. See chain_before_cap_seconds and chain_session.
CHAIN_BEFORE_CAP_MAX_SECONDS=30
CHAIN_BEFORE_CAP_MIN_SECONDS=2
CHAIN_BEFORE_CAP_DIVISOR=4
# A chain that failed (server unreachable, or it refused) is retried this often until the cap.
CHAIN_RETRY_SECONDS=5
# A session the server closed early (frame cap, or ended after the machine slept) is
# continued too, but not when it is this young: a server that answers 410 to everything
# must not produce a session every few seconds.
CHAIN_MIN_SESSION_SECONDS=60

# `afk start` removes old session directories on startup: ended ones (a `done` marker)
# after a day, ones that never ended (a crash) two days after they last changed.
SESSION_DONE_RETENTION_SECONDS=86400
SESSION_ORPHAN_RETENTION_SECONDS=172800

# ---------------------------------------------------------------------------
# helpers
# ---------------------------------------------------------------------------

log()  { printf 'afk: %s\n' "$*" >&2; }
die()  { log "error: $*"; exit 1; }

# Escape a string for use inside a JSON string literal.
json_string() {
  printf '%s' "$1" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g' -e 's/	/\\t/g' | tr -d '\n\r'
}

# Extract a top-level string value from compact JSON (the server always emits compact JSON).
json_get_string() { # json key
  printf '%s' "$1" | sed -n 's/.*"'"$2"'":"\([^"]*\)".*/\1/p'
}
json_get_number() { # json key
  printf '%s' "$1" | sed -n 's/.*"'"$2"'":\([0-9][0-9]*\).*/\1/p'
}

# The server answered 426 Upgrade Required: it will not talk to this client (or this
# protocol version) any more. Print what it said, both minimums, and how to update.
# The details are one level down in the JSON, which the key-based extraction does not mind.
log_upgrade_required() { # response-json
  local message min_client min_protocol
  message=$(json_get_string "$1" error)
  min_client=$(json_get_string "$1" minimumClientVersion)
  min_protocol=$(json_get_number "$1" minimumProtocolVersion)
  log "the server refused this client: ${message:-upgrade required}"
  log "this is afk $AFK_VERSION speaking protocol $AFK_PROTOCOL_VERSION; the server needs client ${min_client:-?} and protocol ${min_protocol:-?} or newer"
  log "update with: curl -fsSL $AFK_DOWNLOAD_URL -o \"$0\" && chmod +x \"$0\""
}

now_seconds() { date +%s; }

random_id() { head -c 4 /dev/urandom | od -An -tx1 | tr -d ' \n'; }

# BSD stat (macOS) and GNU stat (Linux, where the unit tests also run) spell these
# differently; `-f` on GNU stat means the filesystem, so the two cannot be chained.
if [ "$(uname -s)" = "Darwin" ]; then
  file_size() { stat -f %z "$1" 2>/dev/null || echo 0; }
  file_mtime() { stat -f %m "$1" 2>/dev/null || now_seconds; }
else
  file_size() { stat -c %s "$1" 2>/dev/null || echo 0; }
  file_mtime() { stat -c %Y "$1" 2>/dev/null || now_seconds; }
fi

file_age_seconds() { echo $(( $(now_seconds) - $(file_mtime "$1") )); }

pid_alive() { [ -n "${1:-}" ] && kill -0 "$1" 2>/dev/null; }

# The pid that created ~/.afk/current, empty when unknown.
owner_pid() { cat "$AFK_HOME/owner.pid" 2>/dev/null; }

remove_current_session_files() { rm -f "$AFK_HOME/current" "$AFK_HOME/owner.pid"; }

# The queue holds one frame per file (see emit_frame); these size it up for the
# sender's log, `afk status`, and the disk cap.
queue_count() { find "$SESSION_DIR/queue" -name '*.ndjson' -type f 2>/dev/null | wc -l | tr -d ' '; }
queue_bytes() {
  find "$SESSION_DIR/queue" -name '*.ndjson' -type f -exec sh -c 'wc -c < "$1"' _ {} \; 2>/dev/null \
    | awk '{ s += $1 } END { print s + 0 }'
}

check_platform() {
  [ "$(uname -s)" = "Darwin" ] || die "only macOS is supported right now (TODO: linux)"
  command -v curl >/dev/null || die "curl is required"
  detect_curl_features
  mkdir -p "$AFK_HOME"
}

# --fail-with-body (curl 7.76+, so every macOS 8.x) makes a 4xx/5xx response exit 22
# while still saving the body; older curls fall back to the status code alone, which
# http_request reads either way.
CURL_FAIL_FLAG=""
detect_curl_features() {
  if curl --help all 2>/dev/null | grep -q -- --fail-with-body; then
    CURL_FAIL_FLAG="--fail-with-body"
  fi
}

# Every request goes through here. curl's own retries are off so they never double
# up with the sender's. Leaves the HTTP status in HTTP_STATUS and returns 0 for any
# response; when there was none HTTP_STATUS is 000, HTTP_ERROR is curl's reason, and
# it returns 1. (Not a `$(...)` helper on purpose: those variables must reach the caller.)
HTTP_STATUS=000
HTTP_ERROR=""
http_request() { # curl args...
  local rc errors
  errors=$(mktemp "${TMPDIR:-/tmp}/afk-curl.XXXXXX")
  # shellcheck disable=SC2086 # CURL_FAIL_FLAG is empty or one flag, never quoted text
  HTTP_STATUS=$(curl -sS --retry 0 $CURL_FAIL_FLAG -w '%{http_code}' \
    -H "X-Afk-Client: bash/$AFK_VERSION" "$@" 2>"$errors"); rc=$?
  HTTP_ERROR=""
  case "$rc" in
    0|22) rm -f "$errors" ;;
    *)
      HTTP_STATUS=000
      HTTP_ERROR=$(cat "$errors" 2>/dev/null); rm -f "$errors"
      : "${HTTP_ERROR:=curl exited with $rc}"
      return 1 ;;
  esac
}

# ---------------------------------------------------------------------------
# collectors
#
# Each collector is a function that prints ONE compact JSON object describing the
# machine right now. The sampler wraps it in a frame envelope. Keep collectors free of
# interpretation: raw numbers in, server decides what they mean.
#
# TODO(collectors): agents (claude/codex). TODO(linux): /proc equivalents.
# TODO(plugins): allow any executable printing JSON to act as a collector.
# ---------------------------------------------------------------------------

collect_system() {
  # %cpu per process is the kernel's recent decayed average; summed and divided by
  # core count it gives "percent of the whole machine" and is cheap (~20 ms).
  local cpu load1 load5 load15 pressure swap_total_mb swap_used_mb
  cpu=$(ps -A -o %cpu= | awk -v n="$HOST_CPU_COUNT" '{ s += $1 } END { printf "%.1f", s / n }')

  # vm.loadavg looks like "{ 4.16 4.98 4.98 }"
  # shellcheck disable=SC2046 # splitting the three numbers into $1..$3 is the point
  set -- $(sysctl -n vm.loadavg | tr -d '{}')
  load1=$1; load5=$2; load15=$3

  pressure=$(sysctl -n kern.memorystatus_vm_pressure_level)

  # vm.swapusage looks like "total = 10240.00M  used = 9179.50M  free = 1060.50M  (encrypted)"
  # shellcheck disable=SC2046 # splitting the words into $1..$6 is the point
  set -- $(sysctl -n vm.swapusage | tr -d 'M')
  swap_total_mb=$3; swap_used_mb=$6

  # vm_stat prints page counts; first line carries the page size.
  vm_stat | awk -v total="$HOST_MEMORY_BYTES" -v cpu="$cpu" \
    -v l1="$load1" -v l5="$load5" -v l15="$load15" -v pressure="$pressure" \
    -v swap_total_mb="$swap_total_mb" -v swap_used_mb="$swap_used_mb" '
    /page size of/      { page = $8 }
    /^Pages free/       { free = $3 }
    /^Pages active/     { active = $3 }
    /^Pages inactive/   { inactive = $3 }
    /^Pages wired down/ { wired = $4 }
    /^Pages occupied by compressor/ { compressed = $5 }
    END {
      printf "{\"cpu\":{\"percent\":%s},", cpu
      printf "\"loadAverage\":{\"oneMinute\":%s,\"fiveMinutes\":%s,\"fifteenMinutes\":%s},", l1, l5, l15
      printf "\"memory\":{\"pressureLevel\":%d,\"totalBytes\":%d,\"freeBytes\":%d,\"activeBytes\":%d,", pressure, total, free * page, active * page
      printf "\"inactiveBytes\":%d,\"wiredBytes\":%d,\"compressedBytes\":%d,", inactive * page, wired * page, compressed * page
      printf "\"swapUsedBytes\":%d,\"swapTotalBytes\":%d}}", swap_used_mb * 1048576, swap_total_mb * 1048576
    }'
}

# The busiest processes right now. One ps call, sorted by cpu descending (-r), captured
# once: the first PROCESSES_TOP_MAX lines are the frame's `top`, the line count is how
# many processes there were. rss is KiB on macOS and is converted to bytes. `comm` is
# the full executable path and may contain spaces (.app bundles), so everything after
# the fifth column is the command; a small awk function escapes it for JSON.
collect_processes() {
  local listing total
  listing=$(ps -Aro pid=,ppid=,%cpu=,%mem=,rss=,comm=)
  total=$(printf '%s\n' "$listing" | wc -l | tr -d ' ')
  # awk reads the whole listing (instead of `head`, which closes the pipe early and makes
  # printf report a broken pipe once the listing outgrows the pipe buffer).
  printf '%s\n' "$listing" | awk -v total="$total" -v max="$PROCESSES_TOP_MAX" -v max_length="$PROCESS_COMMAND_MAX_LENGTH" '
    function json_escape(s) { gsub(/\\/, "\\\\", s); gsub(/"/, "\\\"", s); return s }
    BEGIN { printf "{\"sampledCount\":%d,\"top\":[", total }
    NR > max { next }
    {
      # Everything after the five numeric columns, spaces intact.
      match($0, /^ *[0-9]+ +[0-9]+ +[0-9.]+ +[0-9.]+ +[0-9]+ +/)
      command = substr($0, RLENGTH + 1, max_length)
      printf "%s{\"pid\":%d,\"parentPid\":%d,\"cpuPercent\":%s,\"memoryPercent\":%s,\"rssBytes\":%d,\"command\":\"%s\"}", \
        (NR > 1 ? "," : ""), $1, $2, $3, $4, $5 * 1024, json_escape(command)
    }
    END { printf "]}" }'
}

# ---------------------------------------------------------------------------
# run collector: wraps one command and reports whether it is alive and how much it
# has written. The basic "volume" flavor only counts bytes, which is enough to tell
# "still going" from "hung". Richer flavors (progress lines, JSON records) can be
# added later under output.flavor without changing the rest of the frame.
# Set up by cmd_run: RUN_ID, RUN_DIR (stdout, stderr, pid, seq), RUN_STARTED, RUN_COMMAND_JSON.
# ---------------------------------------------------------------------------

# The `output.tail` object for the final frame of a failed run: the last
# AFK_RUN_TAIL_LINES lines of the captured stdout and stderr, each cut to
# RUN_TAIL_MAX_LINE_CHARS bytes, with `truncated` set when either stream had more lines
# than were kept. Prints nothing for exit code 0 or when the switch is 0, so the caller
# can pass the result straight to collect_run. Runs in a subshell under the C locale so
# cut counts bytes and sed never chokes on bytes that are not valid UTF-8; ANSI colour
# sequences and control characters other than tab are dropped, the latter because JSON
# strings may not contain them.
run_output_tail() { # exit-code
  (
    export LC_ALL=C
    local lines name file count line json first truncated=false stdout_json="" stderr_json="" esc
    esc=$(printf '\033')
    [ "${1:-0}" -ne 0 ] 2>/dev/null || exit 0
    case "$AFK_RUN_TAIL_LINES" in
      ''|*[!0-9]*) lines=$RUN_TAIL_MAX_LINES ;;
      *) lines=$AFK_RUN_TAIL_LINES ;;
    esac
    [ "$lines" -gt "$RUN_TAIL_MAX_LINES" ] && lines=$RUN_TAIL_MAX_LINES
    [ "$lines" -gt 0 ] || exit 0
    for name in stdout stderr; do
      file="$RUN_DIR/$name"
      # NR counts a final line without a newline too, which is what tail keeps.
      count=$(awk 'END { print NR }' "$file" 2>/dev/null || echo 0)
      [ "${count:-0}" -gt "$lines" ] && truncated=true
      json=""; first=1
      while IFS= read -r line || [ -n "$line" ]; do
        [ "$first" = 1 ] || json="$json,"
        first=0
        json="$json\"$(json_string "$line")\""
      done < <(tail -n "$lines" "$file" 2>/dev/null | sed "s/$esc\[[0-9;]*[a-zA-Z]//g" \
        | cut -c "1-$RUN_TAIL_MAX_LINE_CHARS" | tr -d '\000-\010\013-\037\177')
      if [ "$name" = stdout ]; then stdout_json=$json; else stderr_json=$json; fi
    done
    printf '{"stdout":[%s],"stderr":[%s],"truncated":%s}' "$stdout_json" "$stderr_json" "$truncated"
  )
}

collect_run() { # state [exitCode] [output-tail-json]
  local state=$1 exit_code=${2:-null} tail=${3:-} pid out err cpu rss elapsed
  pid=$(cat "$RUN_DIR/pid" 2>/dev/null || echo 0)
  out=$(file_size "$RUN_DIR/stdout")
  err=$(file_size "$RUN_DIR/stderr")
  elapsed=$(( $(now_seconds) - RUN_STARTED ))
  # ps reports rss in KiB; both read as 0 once the process is gone.
  # shellcheck disable=SC2046 # splitting the two columns into $1 and $2 is the point
  set -- $(ps -o %cpu=,rss= -p "$pid" 2>/dev/null)
  cpu=${1:-0}; rss=${2:-0}
  [ -z "$tail" ] || tail=",\"tail\":$tail"
  printf '{"command":"%s","pid":%d,"state":"%s","exitCode":%s,"elapsedSeconds":%d,"process":{"cpuPercent":%s,"rssBytes":%d},"output":{"flavor":"volume","stdoutBytes":%d,"stderrBytes":%d%s}}' \
    "$RUN_COMMAND_JSON" "$pid" "$state" "$exit_code" "$elapsed" "$cpu" $((rss * 1024)) "$out" "$err" "$tail"
}

# Samples the run every second until killed. Keeps its sequence in a file so the
# final "exited" frame, emitted by the main process, can continue the count.
run_sampler_loop() {
  local seq=0
  while [ ! -s "$RUN_DIR/pid" ]; do
    sleep 0.1
  done
  while true; do
    seq=$((seq + 1))
    echo "$seq" > "$RUN_DIR/seq"
    emit_frame "run:$RUN_ID" run "$seq" "$(collect_run running)"
    sleep "$SAMPLE_INTERVAL_SECONDS"
  done
}

# ---------------------------------------------------------------------------
# session
# ---------------------------------------------------------------------------

gather_host_info() {
  HOST_NAME=$(hostname -s 2>/dev/null || hostname)
  HOST_PLATFORM=$(uname -s | tr '[:upper:]' '[:lower:]')
  HOST_OS_VERSION=$(sw_vers -productVersion 2>/dev/null || uname -r)
  HOST_CPU_COUNT=$(sysctl -n hw.ncpu)
  HOST_MEMORY_BYTES=$(sysctl -n hw.memsize)
}

# Creates a session. Given a previous session's id and ingest token it creates that
# session's successor instead (the token proves it is ours; see chain_session).
# Returns 0 on success, 2 when the server is at capacity (the caller chooses between
# waiting and going on without telemetry), 3 when it could not be reached, and 1 when
# it refused for good: 426 (it no longer talks to this client version; waiting would
# not change that answer, so the update hint is printed) or anything else. It never
# exits itself: a chain runs it with a sender in the background that a `die` would
# orphan.
create_session() { # [previous-session-id previous-ingest-token]
  local previous_id=${1:-} previous_token=${2:-} previous_field="" body response status
  local response_file="$AFK_HOME/create-response.json"
  if [ -n "$previous_id" ]; then
    previous_field=$(printf ',"previousSessionId":"%s"' "$(json_string "$previous_id")")
  fi
  body=$(printf '{"protocolVersion":%d,"clientVersion":"%s","host":{"hostname":"%s","platform":"%s","osVersion":"%s","cpuCount":%d,"memoryTotalBytes":%d}%s}' \
    "$AFK_PROTOCOL_VERSION" "$AFK_VERSION" "$(json_string "$HOST_NAME")" "$(json_string "$HOST_PLATFORM")" \
    "$(json_string "$HOST_OS_VERSION")" "$HOST_CPU_COUNT" "$HOST_MEMORY_BYTES" "$previous_field")

  if [ -n "$previous_id" ]; then
    http_request -o "$response_file" --connect-timeout 5 --max-time 15 \
      -H 'Content-Type: application/json' -H "Authorization: Bearer $previous_token" \
      --data "$body" "$AFK_SERVER/api/sessions"
  else
    http_request -o "$response_file" --connect-timeout 5 --max-time 15 \
      -H 'Content-Type: application/json' \
      --data "$body" "$AFK_SERVER/api/sessions"
  fi || {
    log "could not reach $AFK_SERVER: $HTTP_ERROR"
    return 3
  }
  status=$HTTP_STATUS
  response=$(cat "$response_file" 2>/dev/null)
  rm -f "$response_file"
  case "$status" in
    201) ;;
    503)
      log "server is at capacity: $(json_get_string "$response" error)"
      return 2 ;;
    426)
      log_upgrade_required "$response"
      return 1 ;;
    *)
      log "server refused to start a session (HTTP $status): $response"
      return 1 ;;
  esac

  SESSION_ID=$(json_get_string "$response" sessionId)
  INGEST_TOKEN=$(json_get_string "$response" ingestToken)
  DASHBOARD_URL=$(json_get_string "$response" dashboardUrl)
  MAX_DURATION_SECONDS=$(json_get_number "$response" maxDurationSeconds)
  if [ -z "$SESSION_ID" ] || [ -z "$INGEST_TOKEN" ]; then
    log "unexpected response from server: $response"
    return 1
  fi
  : "${MAX_DURATION_SECONDS:=3600}"

  SESSION_DIR="$AFK_HOME/sessions/$SESSION_ID"
  mkdir -p "$SESSION_DIR/queue"
  # Lets a later `afk run` join this session, and `afk status`/`afk stop` find its owner.
  printf 'sessionId=%s\ningestToken=%s\nserver=%s\ndashboardUrl=%s\n' \
    "$SESSION_ID" "$INGEST_TOKEN" "$AFK_SERVER" "$DASHBOARD_URL" > "$AFK_HOME/current"
  echo "$$" > "$AFK_HOME/owner.pid"
  # Whatever way this process ends (Ctrl-C, `afk stop`, a die), the files that let
  # others join it must not outlive it. Bash resets traps in subshells, so the sender
  # and samplers running in the background do not trigger this when they are killed.
  trap remove_owner_state EXIT
}

remove_owner_state() {
  remove_current_session_files
  rm -f "$AFK_HOME/create-response.json"
}

# For `afk start`: a machine you are about to leave should get a session eventually,
# so wait for capacity rather than fail. Any other failure (unreachable, refused) is
# already explained by create_session and ends the command.
create_session_or_wait() {
  local waited=0 rc
  while true; do
    create_session; rc=$?
    if [ "$rc" = 0 ]; then
      return 0
    fi
    if [ "$rc" != 2 ]; then
      exit 1
    fi
    if [ "$waited" -ge "$CAPACITY_MAX_WAIT_SECONDS" ]; then
      die "gave up waiting for capacity after ${waited}s"
    fi
    log "retrying in ${CAPACITY_RETRY_SECONDS}s (Ctrl-C to give up)"
    sleep "$CAPACITY_RETRY_SECONDS"
    waited=$((waited + CAPACITY_RETRY_SECONDS))
  done
}

# Reads ~/.afk/current, written by the process that owns the session, without
# asking anyone whether it is still valid. Returns 1 if there is none.
read_current_file() {
  local file="$AFK_HOME/current"
  [ -f "$file" ] || return 1
  SESSION_ID=$(sed -n 's/^sessionId=//p' "$file")
  INGEST_TOKEN=$(sed -n 's/^ingestToken=//p' "$file")
  AFK_SERVER=$(sed -n 's/^server=//p' "$file")
  DASHBOARD_URL=$(sed -n 's/^dashboardUrl=//p' "$file")
  [ -n "$SESSION_ID" ] && [ -n "$INGEST_TOKEN" ] || return 1
  SESSION_DIR="$AFK_HOME/sessions/$SESSION_ID"
}

# Loads the session in ~/.afk/current for a joiner. Returns 1 if there is none, its
# owner is gone (a crashed owner leaves the file behind; its pid says so without a
# round trip), or the server says it is over, and 2 if the session is live but already
# has as many streams as the server allows.
load_current_session() {
  local summary summary_file status stream_count max_streams pid
  read_current_file || return 1
  pid=$(owner_pid)
  if [ -n "$pid" ] && ! pid_alive "$pid"; then
    log "ignoring stale session file (its owner, pid $pid, is gone)"
    remove_current_session_files
    return 1
  fi
  summary_file=$(mktemp "${TMPDIR:-/tmp}/afk-summary.XXXXXX")
  http_request -o "$summary_file" --connect-timeout 5 --max-time 10 \
    "$AFK_SERVER/api/sessions/$SESSION_ID" || { rm -f "$summary_file"; return 1; }
  summary=$(cat "$summary_file" 2>/dev/null)
  rm -f "$summary_file"
  status=$(json_get_string "$summary" status)
  if [ "$status" != "active" ]; then
    log "ignoring stale session file (session is ${status:-unknown})"
    remove_current_session_files
    return 1
  fi
  MAX_DURATION_SECONDS=$(json_get_number "$summary" maxDurationSeconds)
  : "${MAX_DURATION_SECONDS:=3600}"
  stream_count=$(json_get_number "$summary" streamCount)
  max_streams=$(json_get_number "$summary" maxStreams)
  if [ -n "$stream_count" ] && [ -n "$max_streams" ] && [ "$stream_count" -ge "$max_streams" ]; then
    log "session $SESSION_ID already has $max_streams streams, the server's limit"
    return 2
  fi
}

# How long before the cap `afk start` opens its successor: a quarter of the cap,
# between CHAIN_BEFORE_CAP_MIN_SECONDS and CHAIN_BEFORE_CAP_MAX_SECONDS.
chain_before_cap_seconds() {
  local before=$((MAX_DURATION_SECONDS / CHAIN_BEFORE_CAP_DIVISOR))
  [ "$before" -le "$CHAIN_BEFORE_CAP_MAX_SECONDS" ] || before=$CHAIN_BEFORE_CAP_MAX_SECONDS
  [ "$before" -ge "$CHAIN_BEFORE_CAP_MIN_SECONDS" ] || before=$CHAIN_BEFORE_CAP_MIN_SECONDS
  echo "$before"
}

# Continues the session in a new one (`afk start` only; see docs/PROTOCOL.md,
# "Chaining"). The server ends the old session the moment its successor exists and
# answers 410 for it from then on, so the old queue is drained first: the sender is
# stopped, what it left is flushed, and only then is the successor created. The new
# URL is printed like the first one, `current` now names the new session (a joining
# `afk run` follows it, see reattach_to_current_session), the sequence counters start
# over because sequences are per session, and a sender is started on the new queue.
# Returns 1, with the old session's sender running again, when the flush did not get
# through or the server would not create the successor; the caller retries.
chain_session() {
  local old_id=$SESSION_ID old_token=$INGEST_TOKEN old_dir=$SESSION_DIR old_cap=$MAX_DURATION_SECONDS rc
  kill "$SENDER_PID" 2>/dev/null; wait "$SENDER_PID" 2>/dev/null
  flush_queue
  # A 410 means the old session is already over on the server (it hit the cap, or its
  # frame limit, or was ended after a long silence); nothing queued for it can be sent
  # any more, and the server still links a successor to an ended session.
  if [ "$(queue_count)" -gt 0 ] && [ "$HTTP_STATUS" != 410 ]; then
    log "could not send the last ${old_cap}s session's queue yet; will try again"
    sender_loop &
    SENDER_PID=$!
    return 1
  fi
  create_session "$old_id" "$old_token"; rc=$?
  if [ "$rc" != 0 ]; then
    sender_loop &
    SENDER_PID=$!
    return 1
  fi
  rm -f "$old_dir/response.json" "$old_dir/batch.ndjson" "$old_dir/gone"
  touch "$old_dir/done"
  SEQ_SYSTEM=0
  SEQ_PROCESSES=0
  SAMPLE_TICK=0
  log "session $old_id reached its ${old_cap}s cap; continuing in session $SESSION_ID (max ${MAX_DURATION_SECONDS}s)"
  printf '\n  %s\n\n' "$DASHBOARD_URL"
  print_qr
  sender_loop &
  SENDER_PID=$!
}

# For an `afk run` that joined someone else's session and whose sends now get 410:
# the owner may have moved on to a successor and rewritten `current`. Re-reads it and,
# when it names a different session whose owner is alive, switches to it, leaving the
# old id in REATTACHED_FROM for the caller's log line. The queue stays where it is (its
# files do not care which session they go to) and so does the stream id: `run:<runId>`
# simply continues in the new session, its sequences with it. Returns 1 when there is
# nothing to re-attach to.
REATTACHED_FROM=""
reattach_to_current_session() {
  local old_id=$SESSION_ID old_token=$INGEST_TOKEN old_dir=$SESSION_DIR old_url=${DASHBOARD_URL:-} old_server=$AFK_SERVER
  [ "${SESSION_ROLE:-owner}" = joiner ] || return 1
  # The owner rewrites `current` right after the server has ended the old session; a
  # send can land in between, so look again after a moment.
  sleep "$SEND_INTERVAL_SECONDS"
  if read_current_file && [ "$SESSION_ID" != "$old_id" ] && pid_alive "$(owner_pid)"; then
    SESSION_DIR=$old_dir
    REATTACHED_FROM=$old_id
    return 0
  fi
  SESSION_ID=$old_id; INGEST_TOKEN=$old_token; SESSION_DIR=$old_dir
  DASHBOARD_URL=$old_url; AFK_SERVER=$old_server
  return 1
}

end_session() {
  http_request -o /dev/null --connect-timeout 3 --max-time 5 -X POST \
    -H "Authorization: Bearer $INGEST_TOKEN" \
    "$AFK_SERVER/api/sessions/$SESSION_ID/end" >/dev/null \
    || log "could not tell the server the session ended ($HTTP_ERROR); it will expire on its own"
  remove_current_session_files
  rm -f "$SESSION_DIR/response.json" "$SESSION_DIR/batch.ndjson"
  # Tells the startup cleanup this directory is finished with.
  touch "$SESSION_DIR/done"
}

# Removes session directories that ended (a `done` marker from end_session) more than
# a day ago, and ones that never ended, which a crash leaves behind, two days after
# the directory itself last changed (the sender touches it on every send).
cleanup_old_sessions() {
  local dir
  for dir in "$AFK_HOME"/sessions/*; do
    [ -d "$dir" ] || continue
    if [ -e "$dir/done" ]; then
      [ "$(file_age_seconds "$dir/done")" -gt "$SESSION_DONE_RETENTION_SECONDS" ] && rm -rf "$dir"
    else
      [ "$(file_age_seconds "$dir")" -gt "$SESSION_ORPHAN_RETENTION_SECONDS" ] && rm -rf "$dir"
    fi
  done
  return 0
}

# ---------------------------------------------------------------------------
# sampler: runs collectors on their interval, writes one file per frame into queue/
# ---------------------------------------------------------------------------

SEQ_SYSTEM=0
SEQ_PROCESSES=0
# Counts sampler ticks (one per SAMPLE_INTERVAL_SECONDS) so slower collectors can run
# every Nth tick; the first tick runs every collector so a session starts with each stream.
SAMPLE_TICK=0

# One frame per file, named `<sequence>-<stream>.ndjson` so that `queue/*.ndjson` in
# name order is sequence order within every stream, which is the only order the server
# cares about (it de-duplicates per stream by sequence; a frame arriving after a higher
# sequence of its stream would be dropped). The frame is written to a hidden temp file
# and renamed into place: rename is atomic, so the sender never sees a partial file,
# and with no shared spool file there is nothing for the sampler and sender to race
# on (macOS has no flock).
emit_frame() { # stream collector sequence data-json
  local name temp
  name=$(printf '%010d-%s.ndjson' "$3" "$1")
  temp="$SESSION_DIR/queue/.$name.tmp"
  printf '{"stream":"%s","collector":"%s","sequence":%d,"timestamp":%d,"data":%s}\n' \
    "$1" "$2" "$3" "$(now_seconds)" "$4" > "$temp" && mv "$temp" "$SESSION_DIR/queue/$name"
}

# True on the ticks a collector with this interval (in seconds) is due.
due_every() { # interval-seconds
  [ $(( (SAMPLE_TICK - 1) % ($1 / SAMPLE_INTERVAL_SECONDS) )) -eq 0 ]
}

sample_once() {
  SAMPLE_TICK=$((SAMPLE_TICK + 1))
  SEQ_SYSTEM=$((SEQ_SYSTEM + 1))
  emit_frame system system "$SEQ_SYSTEM" "$(collect_system)"
  if due_every "$PROCESSES_INTERVAL_SECONDS"; then
    SEQ_PROCESSES=$((SEQ_PROCESSES + 1))
    emit_frame processes processes "$SEQ_PROCESSES" "$(collect_processes)"
  fi
}

# ---------------------------------------------------------------------------
# sender: ships the oldest queued frames as one batch per request, deletes them
# on success, backs off and retries forever on failure
# ---------------------------------------------------------------------------

# Sends up to SEND_MAX_FILES_PER_BATCH oldest queue files (one frame each) as one request.
# Returns 0 on success (files deleted), 1 on a retryable failure, 2 when the session is
# over on the server (410), and 3 when the server will no longer talk to this client
# version (426). The queue is kept on 2 and 3.
send_oldest_batch() {
  local batch="$SESSION_DIR/batch.ndjson" files="" count=0 f status
  for f in "$SESSION_DIR"/queue/*.ndjson; do
    [ -e "$f" ] || break
    files="$files $f"
    count=$((count + 1))
    [ "$count" -ge "$SEND_MAX_FILES_PER_BATCH" ] && break
  done
  [ "$count" -gt 0 ] || return 0

  # shellcheck disable=SC2086
  cat $files > "$batch"
  http_request -o "$SESSION_DIR/response.json" \
    --connect-timeout 5 --max-time 20 \
    -H "Authorization: Bearer $INGEST_TOKEN" -H 'Content-Type: application/x-ndjson' \
    --data-binary "@$batch" "$AFK_SERVER/api/sessions/$SESSION_ID/frames"
  status=$HTTP_STATUS

  case "$status" in
    2*)
      # shellcheck disable=SC2086
      rm -f $files "$batch"
      return 0 ;;
    410)
      log "server closed the session ($(cat "$SESSION_DIR/response.json" 2>/dev/null))"
      return 2 ;;
    426)
      # The server stopped talking to this client version mid-session: stop, keep the
      # queue, and print the hint on how to update.
      log_upgrade_required "$(cat "$SESSION_DIR/response.json" 2>/dev/null)"
      return 3 ;;
    400|401|404|413|422)
      # The server will never accept this batch; keep it out of the way so we don't stall.
      # TODO(hardening): decide whether to keep these for debugging or drop them.
      log "server rejected batch with HTTP $status: $(cat "$SESSION_DIR/response.json" 2>/dev/null)"
      mkdir -p "$SESSION_DIR/rejected"
      # shellcheck disable=SC2086
      mv $files "$SESSION_DIR/rejected/"
      return 0 ;;
    *)
      return 1 ;;
  esac
}

# Drops the oldest queued frames until the queue is back under SPOOL_MAX_BYTES. Only
# an outage grows the queue, so the sender calls this after every failed send. Frames
# dropped here are gone for good; the log line is rate limited because a long outage
# would otherwise print one per retry.
SPOOL_DROPPED_BYTES=0
SPOOL_DROPPED_FRAMES=0
SPOOL_DROP_LOGGED_AT=0

enforce_spool_cap() {
  local total f size now
  total=$(queue_bytes)
  [ "$total" -gt "$SPOOL_MAX_BYTES" ] || return 0
  for f in "$SESSION_DIR"/queue/*.ndjson; do
    [ -e "$f" ] || break
    [ "$total" -gt "$SPOOL_MAX_BYTES" ] || break
    size=$(file_size "$f")
    rm -f "$f"
    total=$((total - size))
    SPOOL_DROPPED_BYTES=$((SPOOL_DROPPED_BYTES + size))
    SPOOL_DROPPED_FRAMES=$((SPOOL_DROPPED_FRAMES + 1))
  done
  now=$(now_seconds)
  if [ $((now - SPOOL_DROP_LOGGED_AT)) -ge "$SPOOL_DROP_LOG_INTERVAL_SECONDS" ]; then
    log "queue is over ${SPOOL_MAX_BYTES} bytes; dropped the oldest ${SPOOL_DROPPED_FRAMES} frames (${SPOOL_DROPPED_BYTES} bytes)"
    SPOOL_DROPPED_BYTES=0
    SPOOL_DROPPED_FRAMES=0
    SPOOL_DROP_LOGGED_AT=$now
  fi
}

# The session being over on the server (410) ends the sender, and with it the sampler,
# except that a joiner follows its owner to a successor session, and an `afk start`
# owner is told (a `gone` marker, see system_sampler_loop) so it can open one itself.
sender_loop() {
  local backoff=1 rc
  while true; do
    send_oldest_batch; rc=$?
    case "$rc" in
      0) backoff=1; sleep "$SEND_INTERVAL_SECONDS" ;;
      1) enforce_spool_cap
         log "send failed (${HTTP_ERROR:-HTTP $HTTP_STATUS}), retrying in ${backoff}s (queued: $(queue_count) frames)"
         sleep "$backoff"
         backoff=$((backoff * 2)); [ "$backoff" -gt "$SEND_MAX_BACKOFF_SECONDS" ] && backoff=$SEND_MAX_BACKOFF_SECONDS ;;
      2)
        if reattach_to_current_session; then
          log "session $REATTACHED_FROM ended; continuing in session $SESSION_ID"
          backoff=1
          continue
        fi
        if [ "${SESSION_CHAINING:-0}" = 1 ]; then
          touch "$SESSION_DIR/gone"
        else
          touch "$SESSION_DIR/stop"
        fi
        return ;;
      3) touch "$SESSION_DIR/stop"; return ;;
    esac
  done
}

# Final attempt to drain the queue when the session ends. Best effort, short timeout.
flush_queue() {
  while [ "$(queue_count)" -gt 0 ]; do
    send_oldest_batch || break
  done
}

# ---------------------------------------------------------------------------
# commands
# ---------------------------------------------------------------------------

# Samples machine health until the session is stopped (by the server via the
# sender, or by hitting the cap). Runs in the foreground for `afk start`, which sets
# SESSION_CHAINING so the loop hands over to a successor session before the cap (see
# chain_session), and in the background for an `afk run` that had to start its own
# session, which stops at the cap: its run sampler and final frame would not follow
# a switch (TODO(sessions), see BACKLOG.md).
system_sampler_loop() {
  local started now deadline chain_at chain_attempted_at=0
  started=$(now_seconds)
  deadline=$started
  chain_at=$((MAX_DURATION_SECONDS - $(chain_before_cap_seconds)))
  while [ ! -e "$SESSION_DIR/stop" ]; do
    now=$(now_seconds)
    # Chain before the cap, or as soon as the server has closed the session under us
    # (`gone`, left by the sender on a 410) unless it did so almost at once. A chain
    # that fails is retried every CHAIN_RETRY_SECONDS until the cap stops the loop.
    if [ "${SESSION_CHAINING:-0}" = 1 ] && [ $((now - chain_attempted_at)) -ge "$CHAIN_RETRY_SECONDS" ] \
      && { [ $((now - started)) -ge "$chain_at" ] \
        || { [ -e "$SESSION_DIR/gone" ] && [ $((now - started)) -ge "$CHAIN_MIN_SESSION_SECONDS" ]; }; }; then
      chain_attempted_at=$now
      if chain_session; then
        started=$(now_seconds)
        now=$started
        chain_at=$((MAX_DURATION_SECONDS - $(chain_before_cap_seconds)))
        chain_attempted_at=0
      fi
    fi
    if [ $((now - started)) -ge "$MAX_DURATION_SECONDS" ]; then
      log "reached the maximum session length"
      touch "$SESSION_DIR/stop"
      break
    fi
    sample_once
    # Ticks are scheduled against a deadline that advances by the interval, rather
    # than sleeping a fixed interval after the collectors, so their runtime does not
    # push every tick later than the last. Stock macOS has no sub-second clock (no
    # `date +%N`), so a tick that finishes early sleeps to the next whole second
    # and one that finishes late is followed by the next tick straight away: single
    # gaps vary by the collectors' runtime, but the average rate stays at 1 Hz. A
    # deadline more than SAMPLE_MAX_CATCHUP_SECONDS behind (the machine slept) is
    # re-based on the current time instead of being caught up in a burst.
    deadline=$((deadline + SAMPLE_INTERVAL_SECONDS))
    now=$(now_seconds)
    if [ "$now" -lt "$deadline" ]; then
      sleep $((deadline - now))
    elif [ $((now - deadline)) -gt "$SAMPLE_MAX_CATCHUP_SECONDS" ]; then
      deadline=$now
    fi
  done
}

# ---------------------------------------------------------------------------
# qr code: the dashboard URL, drawn for a phone camera. Rendered by the server
# (bash has no QR library; see docs/PROTOCOL.md) and printed under the URL.
# ---------------------------------------------------------------------------

# Whether stdout is a terminal; the tests override this after sourcing the script.
stdout_is_terminal() { [ -t 1 ]; }

# Fetches the current session's QR code and prints it, block plus URL line, exactly as
# the server sent it. Prints nothing and returns 1 unless the server answered 200.
fetch_qr() {
  local file="$AFK_HOME/qr-$$.txt" status
  status=$(curl -sS -o "$file" -w '%{http_code}' --connect-timeout 3 --max-time 5 \
    -H "Authorization: Bearer $INGEST_TOKEN" -H "X-Afk-Client: bash/$AFK_VERSION" \
    "$AFK_SERVER/api/sessions/$SESSION_ID/qr" 2>/dev/null) || status=000
  # Only print what looks like a QR code: an older server answers unknown /api paths
  # with the dashboard's HTML and a 200, and that must never be dumped on the terminal.
  if [ "$status" = 200 ] && head -c 3 "$file" | grep -q "$(printf '\342\226')"; then
    cat "$file"
    rm -f "$file"
    return 0
  fi
  rm -f "$file"
  return 1
}

# Prints the QR code after a session's URL, when it would be seen: only on a terminal
# (a pipe or a log file gets the URL alone) and not when --no-qr or AFK_NO_QR=1 turned
# it off. A failed fetch prints nothing; the session never depends on it.
print_qr() {
  if [ "${AFK_NO_QR:-0}" = 1 ]; then
    return 0
  fi
  stdout_is_terminal || return 0
  fetch_qr || true
}

cmd_qr() {
  local rc
  load_current_session; rc=$?
  # 2 means the session is live but full of streams, which is no reason not to show its URL.
  if [ "$rc" = 1 ]; then
    die "no active session on this machine (start one with 'afk start')"
  fi
  fetch_qr || die "could not fetch the QR code from $AFK_SERVER; the dashboard is at $DASHBOARD_URL"
}

cmd_start() {
  local arg
  for arg in "$@"; do
    case "$arg" in
      --no-qr) AFK_NO_QR=1 ;;
      *) die "unknown option: $arg (try 'afk help')" ;;
    esac
  done
  check_platform
  cleanup_old_sessions
  gather_host_info
  create_session_or_wait
  log "session $SESSION_ID started (max ${MAX_DURATION_SECONDS}s). Ctrl-C to end."
  printf '\n  %s\n\n' "$DASHBOARD_URL"
  print_qr

  sender_loop &
  SENDER_PID=$!

  # One Ctrl-C (or `afk stop`) sends what is still queued and tells the server; a
  # second one during that gives up on the flush and exits at once (the EXIT trap
  # set by create_session still removes the owner's state files).
  finish() {
    trap abandon INT TERM
    log "ending session... (Ctrl-C again to skip sending what is still queued)"
    kill "$SENDER_PID" 2>/dev/null; wait "$SENDER_PID" 2>/dev/null
    flush_queue
    end_session
    log "session ended. Dashboard stays available at $DASHBOARD_URL"
    exit 0
  }
  # shellcheck disable=SC2329,SC2317 # invoked through the trap finish sets (2317 is the older code)
  abandon() {
    trap - INT TERM
    log "interrupted again; leaving $(queue_count) queued frames unsent in $SESSION_DIR"
    exit 130
  }
  trap finish INT TERM

  # Only `afk start` chains: its sampler runs in this shell and can restart the sender.
  SESSION_CHAINING=1
  system_sampler_loop
  finish
}

cmd_run() {
  if [ "${1:-}" = "--no-qr" ]; then
    AFK_NO_QR=1
    shift
  fi
  [ "${1:-}" = "--" ] && shift
  [ $# -gt 0 ] || die "usage: afk run -- <command> [args...]"
  check_platform

  # Telemetry must never get in the way of the command itself: if the server is full,
  # unreachable, refuses this client, or the session already has its maximum number
  # of streams, just run the command.
  local owner=0 joined
  load_current_session; joined=$?
  case "$joined" in
    0)
      log "joining session $SESSION_ID"
      # The sender follows the owner to a successor session when this one ends.
      SESSION_ROLE=joiner ;;
    1)
      owner=1
      gather_host_info
      if ! create_session; then
        log "running without telemetry"
        exec "$@"
      fi
      log "no session running here; started $SESSION_ID with machine telemetry for the length of this command" ;;
    *)
      log "running without telemetry"
      exec "$@" ;;
  esac

  RUN_ID=$(random_id)
  RUN_STARTED=$(now_seconds)
  RUN_COMMAND_JSON=$(json_string "$*" | cut -c1-200)
  RUN_DIR="$AFK_HOME/sessions/$SESSION_ID/runs/$RUN_ID"
  mkdir -p "$RUN_DIR"
  if [ "$owner" = 0 ]; then
    # A joiner keeps its own spool so it never races the owner's sender.
    SESSION_DIR="$RUN_DIR"
    mkdir -p "$SESSION_DIR/queue"
  fi
  printf '\n  %s\n\n' "$DASHBOARD_URL"
  # A joiner's URL was already printed, QR and all, by the `afk start` that owns it.
  if [ "$owner" = 1 ]; then
    print_qr
  fi

  sender_loop &
  SENDER_PID=$!
  SYSTEM_PID=""
  if [ "$owner" = 1 ]; then
    system_sampler_loop &
    SYSTEM_PID=$!
  fi
  run_sampler_loop &
  RUN_SAMPLER_PID=$!

  # The command runs in the foreground so Ctrl-C and stdin behave as usual. Bash
  # would normally exit when a foreground child dies of SIGINT; trapping it lets us
  # still report the exit. The sh wrapper records the pid the sampler should watch.
  # TODO(run): tee adds a little latency to the final byte counts; a short pause covers it.
  trap ':' INT TERM
  sh -c 'echo $$ > "$1"; shift; exec "$@"' sh "$RUN_DIR/pid" "$@" \
    > >(tee -a "$RUN_DIR/stdout") 2> >(tee -a "$RUN_DIR/stderr" >&2)
  EXIT_CODE=$?
  trap - INT TERM

  kill "$RUN_SAMPLER_PID" 2>/dev/null; wait "$RUN_SAMPLER_PID" 2>/dev/null
  sleep 0.3
  local seq
  seq=$(( $(cat "$RUN_DIR/seq" 2>/dev/null || echo 0) + 1 ))
  # Only a failure ships any output, and only its tail (empty for exit code 0).
  emit_frame "run:$RUN_ID" run "$seq" "$(collect_run exited "$EXIT_CODE" "$(run_output_tail "$EXIT_CODE")")"
  log "command exited with status $EXIT_CODE"

  if [ -n "$SYSTEM_PID" ]; then
    kill "$SYSTEM_PID" 2>/dev/null; wait "$SYSTEM_PID" 2>/dev/null
  fi
  kill "$SENDER_PID" 2>/dev/null; wait "$SENDER_PID" 2>/dev/null
  flush_queue
  # A joiner whose owner moved on to a successor during the command (the sender in the
  # background followed it; this shell still has the old session) sends what is left,
  # the final frame included, to the successor.
  if [ "$HTTP_STATUS" = 410 ] && reattach_to_current_session; then
    log "session $REATTACHED_FROM ended; sending the last frames of this run to session $SESSION_ID"
    flush_queue
  fi
  if [ "$owner" = 1 ]; then
    end_session
    log "session ended. Dashboard stays available at $DASHBOARD_URL"
  fi
  exit "$EXIT_CODE"
}

# Reports on the session in ~/.afk/current from local state only: no network, so it
# answers instantly even when the server is unreachable. The queue counted is the
# owner's; an `afk run` that joined keeps its own under runs/<runId>/.
cmd_status() {
  local pid owner
  if ! read_current_file; then
    printf 'no session running on this machine\n'
    exit 1
  fi
  pid=$(owner_pid)
  if [ -z "$pid" ]; then
    owner="unknown (no owner.pid)"
  elif pid_alive "$pid"; then
    owner="pid $pid, running"
  else
    owner="pid $pid, not running (stale; afk stop clears it)"
  fi
  printf 'session    %s\ndashboard  %s\nowner      %s\nqueue      %s frames, %s bytes\n' \
    "$SESSION_ID" "$DASHBOARD_URL" "$owner" "$(queue_count)" "$(queue_bytes)"
}

# Ends the session by asking its owner (the `afk start` or owning `afk run` process)
# to finish, the same as a Ctrl-C there: it flushes what it can and tells the server.
# Bash runs a trap after the command in flight, so the owner may take up to one
# request's timeout to react.
cmd_stop() {
  local pid
  if ! read_current_file; then
    log "no session running on this machine"
    exit 1
  fi
  pid=$(owner_pid)
  if pid_alive "$pid"; then
    kill -TERM "$pid" || die "could not signal pid $pid"
    log "asked pid $pid to end session $SESSION_ID"
  else
    log "session $SESSION_ID has no running owner${pid:+ (pid $pid is gone)}; clearing its stale state"
    remove_current_session_files
    exit 1
  fi
}

usage() {
  sed -n '2,/^$/p' "$0" | sed 's/^# \{0,1\}//'
}

main() {
  case "${1:-}" in
    start)   shift; cmd_start "$@" ;;
    run)     shift; cmd_run "$@" ;;
    status)  cmd_status ;;
    stop)    cmd_stop ;;
    qr)      cmd_qr ;;
    version) printf 'afk %s\n' "$AFK_VERSION" ;;
    -h|--help|help|"") usage ;;
    *)       die "unknown command: $1 (try 'afk help')" ;;
  esac
}

# Sourcing the script with AFK_SOURCED=1 loads the functions without running anything,
# which is how the tests exercise them.
if [ "${AFK_SOURCED:-0}" != 1 ]; then
  main "$@"
fi
