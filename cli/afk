#!/bin/bash
#
# afk — away-from-keyboard telemetry for your machine.
#
# Starts a session, samples machine health once a second (and the busiest processes
# every few seconds), and streams it to an afk server so you can watch a shareable
# dashboard from your phone. Designed to be downloaded, read, and run: plain bash 3.2
# (what macOS ships), curl, and stock macOS tools only. No jq, no python.
#
# Usage:
#   afk start [--no-qr]  start a session in the foreground (Ctrl-C to end it)
#   afk run [--no-qr] -- <cmd>
#                        run a command and report its progress; joins the session
#                        started by `afk start` if one is running on this machine,
#                        otherwise starts one (with machine telemetry) for the
#                        lifetime of the command
#   afk qr               print the current session's dashboard URL as a QR code again
#   afk version
#
# The dashboard URL is printed with a QR code under it when stdout is a terminal, so
# you can point a phone at the screen instead of typing it; --no-qr skips that.
#
# Environment:
#   AFK_SERVER   server origin, default https://afk.osv.im (self-hosting is the plan)
#   AFK_HOME     state directory, default ~/.afk
#   AFK_NO_QR    set to 1 to never print the QR code (same as --no-qr)
#
# Layout of ~/.afk:
#   current                        the active session (id, token, server) so other
#                                  afk processes can join it
#   sessions/<id>/current.ndjson   frames sampled but not yet handed to the sender
#   sessions/<id>/queue/*.ndjson   rotated batches waiting to be sent; deleted on 2xx
#   sessions/<id>/runs/<runId>/    an `afk run`: captured stdout/stderr, pid, and (when it
#                                  joined an existing session) its own spool and queue
#
# The client is deliberately dumb: it ships raw measurements and lets the server
# decide what is normal. That way the server can improve without anyone re-downloading
# this script.

set -u

# Client version (semver, bumped on every release) and the protocol version it speaks
# (bumped only for an incompatible wire change). See docs/VERSIONING.md.
AFK_VERSION="0.2.0"
AFK_PROTOCOL_VERSION=1
AFK_SERVER="${AFK_SERVER:-https://afk.osv.im}"
AFK_HOME="${AFK_HOME:-$HOME/.afk}"
# Where the upgrade hint says to fetch a newer copy of this script from.
AFK_DOWNLOAD_URL="https://raw.githubusercontent.com/vaskevich/afk/main/cli/afk"

# The sampler ticks once per SAMPLE_INTERVAL_SECONDS; each collector runs on every tick
# or, for the slower ones, every N seconds (must be a multiple of the tick).
SAMPLE_INTERVAL_SECONDS=1
PROCESSES_INTERVAL_SECONDS=5
# How many of the busiest processes a processes frame carries (PROCESSES_TOP_MAX in shared).
PROCESSES_TOP_MAX=10
# Full executable paths are cut to this many characters (PROCESS_COMMAND_MAX_LENGTH in shared).
PROCESS_COMMAND_MAX_LENGTH=512
SEND_INTERVAL_SECONDS=1
SEND_MAX_BACKOFF_SECONDS=30
SEND_MAX_FILES_PER_BATCH=200

# When the server is at capacity, `afk start` waits and retries this often, for at most this long.
CAPACITY_RETRY_SECONDS=30
CAPACITY_MAX_WAIT_SECONDS=600

# ---------------------------------------------------------------------------
# helpers
# ---------------------------------------------------------------------------

log()  { printf 'afk: %s\n' "$*" >&2; }
die()  { log "error: $*"; exit 1; }

# Escape a string for use inside a JSON string literal.
json_string() {
  printf '%s' "$1" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g' -e 's/	/\\t/g' | tr -d '\n\r'
}

# Extract a top-level string value from compact JSON (the server always emits compact JSON).
json_get_string() { # json key
  printf '%s' "$1" | sed -n 's/.*"'"$2"'":"\([^"]*\)".*/\1/p'
}
json_get_number() { # json key
  printf '%s' "$1" | sed -n 's/.*"'"$2"'":\([0-9][0-9]*\).*/\1/p'
}

# The server answered 426 Upgrade Required: it will not talk to this client (or this
# protocol version) any more. Print what it said, both minimums, and how to update.
# The details are one level down in the JSON, which the key-based extraction does not mind.
log_upgrade_required() { # response-json
  local message min_client min_protocol
  message=$(json_get_string "$1" error)
  min_client=$(json_get_string "$1" minimumClientVersion)
  min_protocol=$(json_get_number "$1" minimumProtocolVersion)
  log "the server refused this client: ${message:-upgrade required}"
  log "this is afk $AFK_VERSION speaking protocol $AFK_PROTOCOL_VERSION; the server needs client ${min_client:-?} and protocol ${min_protocol:-?} or newer"
  log "update with: curl -fsSL $AFK_DOWNLOAD_URL -o \"$0\" && chmod +x \"$0\""
}

now_seconds() { date +%s; }

random_id() { head -c 4 /dev/urandom | od -An -tx1 | tr -d ' \n'; }

file_size() { stat -f %z "$1" 2>/dev/null || echo 0; }

check_platform() {
  [ "$(uname -s)" = "Darwin" ] || die "only macOS is supported right now (TODO: linux)"
  command -v curl >/dev/null || die "curl is required"
  mkdir -p "$AFK_HOME"
}

# ---------------------------------------------------------------------------
# collectors
#
# Each collector is a function that prints ONE compact JSON object describing the
# machine right now. The sampler wraps it in a frame envelope. Keep collectors free of
# interpretation: raw numbers in, server decides what they mean.
#
# TODO(collectors): agents (claude/codex). TODO(linux): /proc equivalents.
# TODO(plugins): allow any executable printing JSON to act as a collector.
# ---------------------------------------------------------------------------

collect_system() {
  # %cpu per process is the kernel's recent decayed average; summed and divided by
  # core count it gives "percent of the whole machine" and is cheap (~20 ms).
  local cpu load1 load5 load15 pressure page_size swap_total_mb swap_used_mb
  cpu=$(ps -A -o %cpu= | awk -v n="$HOST_CPU_COUNT" '{ s += $1 } END { printf "%.1f", s / n }')

  # vm.loadavg looks like "{ 4.16 4.98 4.98 }"
  set -- $(sysctl -n vm.loadavg | tr -d '{}')
  load1=$1; load5=$2; load15=$3

  pressure=$(sysctl -n kern.memorystatus_vm_pressure_level)

  # vm.swapusage looks like "total = 10240.00M  used = 9179.50M  free = 1060.50M  (encrypted)"
  set -- $(sysctl -n vm.swapusage | tr -d 'M')
  swap_total_mb=$3; swap_used_mb=$6

  # vm_stat prints page counts; first line carries the page size.
  vm_stat | awk -v total="$HOST_MEMORY_BYTES" -v cpu="$cpu" \
    -v l1="$load1" -v l5="$load5" -v l15="$load15" -v pressure="$pressure" \
    -v swap_total_mb="$swap_total_mb" -v swap_used_mb="$swap_used_mb" '
    /page size of/      { page = $8 }
    /^Pages free/       { free = $3 }
    /^Pages active/     { active = $3 }
    /^Pages inactive/   { inactive = $3 }
    /^Pages wired down/ { wired = $4 }
    /^Pages occupied by compressor/ { compressed = $5 }
    END {
      printf "{\"cpu\":{\"percent\":%s},", cpu
      printf "\"loadAverage\":{\"oneMinute\":%s,\"fiveMinutes\":%s,\"fifteenMinutes\":%s},", l1, l5, l15
      printf "\"memory\":{\"pressureLevel\":%d,\"totalBytes\":%d,\"freeBytes\":%d,\"activeBytes\":%d,", pressure, total, free * page, active * page
      printf "\"inactiveBytes\":%d,\"wiredBytes\":%d,\"compressedBytes\":%d,", inactive * page, wired * page, compressed * page
      printf "\"swapUsedBytes\":%d,\"swapTotalBytes\":%d}}", swap_used_mb * 1048576, swap_total_mb * 1048576
    }'
}

# The busiest processes right now. One ps call, sorted by cpu descending (-r), captured
# once: the first PROCESSES_TOP_MAX lines are the frame's `top`, the line count is how
# many processes there were. rss is KiB on macOS and is converted to bytes. `comm` is
# the full executable path and may contain spaces (.app bundles), so everything after
# the fifth column is the command; a small awk function escapes it for JSON.
collect_processes() {
  local listing total
  listing=$(ps -Aro pid=,ppid=,%cpu=,%mem=,rss=,comm=)
  total=$(printf '%s\n' "$listing" | wc -l | tr -d ' ')
  printf '%s\n' "$listing" | head -n "$PROCESSES_TOP_MAX" | awk -v total="$total" -v max_length="$PROCESS_COMMAND_MAX_LENGTH" '
    function json_escape(s) { gsub(/\\/, "\\\\", s); gsub(/"/, "\\\"", s); return s }
    BEGIN { printf "{\"sampledCount\":%d,\"top\":[", total }
    {
      # Everything after the five numeric columns, spaces intact.
      match($0, /^ *[0-9]+ +[0-9]+ +[0-9.]+ +[0-9.]+ +[0-9]+ +/)
      command = substr($0, RLENGTH + 1, max_length)
      printf "%s{\"pid\":%d,\"parentPid\":%d,\"cpuPercent\":%s,\"memoryPercent\":%s,\"rssBytes\":%d,\"command\":\"%s\"}", \
        (NR > 1 ? "," : ""), $1, $2, $3, $4, $5 * 1024, json_escape(command)
    }
    END { printf "]}" }'
}

# ---------------------------------------------------------------------------
# run collector: wraps one command and reports whether it is alive and how much it
# has written. The basic "volume" flavor only counts bytes, which is enough to tell
# "still going" from "hung". Richer flavors (progress lines, JSON records) can be
# added later under output.flavor without changing the rest of the frame.
# Set up by cmd_run: RUN_ID, RUN_DIR (stdout, stderr, pid, seq), RUN_STARTED, RUN_COMMAND_JSON.
# ---------------------------------------------------------------------------

collect_run() { # state [exitCode]
  local state=$1 exit_code=${2:-null} pid out err cpu rss elapsed
  pid=$(cat "$RUN_DIR/pid" 2>/dev/null || echo 0)
  out=$(file_size "$RUN_DIR/stdout")
  err=$(file_size "$RUN_DIR/stderr")
  elapsed=$(( $(now_seconds) - RUN_STARTED ))
  # ps reports rss in KiB; both read as 0 once the process is gone.
  set -- $(ps -o %cpu=,rss= -p "$pid" 2>/dev/null)
  cpu=${1:-0}; rss=${2:-0}
  printf '{"command":"%s","pid":%d,"state":"%s","exitCode":%s,"elapsedSeconds":%d,"process":{"cpuPercent":%s,"rssBytes":%d},"output":{"flavor":"volume","stdoutBytes":%d,"stderrBytes":%d}}' \
    "$RUN_COMMAND_JSON" "$pid" "$state" "$exit_code" "$elapsed" "$cpu" $((rss * 1024)) "$out" "$err"
}

# Samples the run every second until killed. Keeps its sequence in a file so the
# final "exited" frame, emitted by the main process, can continue the count.
run_sampler_loop() {
  local seq=0
  while [ ! -s "$RUN_DIR/pid" ]; do
    sleep 0.1
  done
  while true; do
    seq=$((seq + 1))
    echo "$seq" > "$RUN_DIR/seq"
    emit_frame "run:$RUN_ID" run "$seq" "$(collect_run running)"
    sleep "$SAMPLE_INTERVAL_SECONDS"
  done
}

# ---------------------------------------------------------------------------
# session
# ---------------------------------------------------------------------------

gather_host_info() {
  HOST_NAME=$(hostname -s 2>/dev/null || hostname)
  HOST_PLATFORM=$(uname -s | tr 'A-Z' 'a-z')
  HOST_OS_VERSION=$(sw_vers -productVersion 2>/dev/null || uname -r)
  HOST_CPU_COUNT=$(sysctl -n hw.ncpu)
  HOST_MEMORY_BYTES=$(sysctl -n hw.memsize)
}

# Creates a session. Returns 0 on success and 2 when the server is at capacity, so the
# caller can choose between waiting and going on without telemetry. Dies on anything
# else, including 426 (the server no longer talks to this client version): waiting
# would not change that answer, so it prints how to update and exits.
create_session() {
  local body response status response_file="$AFK_HOME/create-response.json"
  body=$(printf '{"protocolVersion":%d,"clientVersion":"%s","host":{"hostname":"%s","platform":"%s","osVersion":"%s","cpuCount":%d,"memoryTotalBytes":%d}}' \
    "$AFK_PROTOCOL_VERSION" "$AFK_VERSION" "$(json_string "$HOST_NAME")" "$(json_string "$HOST_PLATFORM")" \
    "$(json_string "$HOST_OS_VERSION")" "$HOST_CPU_COUNT" "$HOST_MEMORY_BYTES")

  status=$(curl -sS -o "$response_file" -w '%{http_code}' --connect-timeout 5 --max-time 15 \
    -H 'Content-Type: application/json' -H "X-Afk-Client: bash/$AFK_VERSION" \
    --data "$body" "$AFK_SERVER/api/sessions") || die "could not reach $AFK_SERVER"
  response=$(cat "$response_file" 2>/dev/null)
  rm -f "$response_file"
  case "$status" in
    201) ;;
    503)
      log "server is at capacity: $(json_get_string "$response" error)"
      return 2 ;;
    426)
      log_upgrade_required "$response"
      exit 1 ;;
    *) die "server refused to start a session (HTTP $status): $response" ;;
  esac

  SESSION_ID=$(json_get_string "$response" sessionId)
  INGEST_TOKEN=$(json_get_string "$response" ingestToken)
  DASHBOARD_URL=$(json_get_string "$response" dashboardUrl)
  MAX_DURATION_SECONDS=$(json_get_number "$response" maxDurationSeconds)
  [ -n "$SESSION_ID" ] && [ -n "$INGEST_TOKEN" ] || die "unexpected response from server: $response"
  : "${MAX_DURATION_SECONDS:=3600}"

  SESSION_DIR="$AFK_HOME/sessions/$SESSION_ID"
  mkdir -p "$SESSION_DIR/queue"
  # Lets a later `afk run` join this session.
  printf 'sessionId=%s\ningestToken=%s\nserver=%s\ndashboardUrl=%s\n' \
    "$SESSION_ID" "$INGEST_TOKEN" "$AFK_SERVER" "$DASHBOARD_URL" > "$AFK_HOME/current"
}

# For `afk start`: a machine you are about to leave should get a session eventually,
# so wait for capacity rather than fail.
create_session_or_wait() {
  local waited=0 rc
  while true; do
    create_session; rc=$?
    if [ "$rc" = 0 ]; then
      return 0
    fi
    if [ "$rc" != 2 ]; then
      exit 1
    fi
    if [ "$waited" -ge "$CAPACITY_MAX_WAIT_SECONDS" ]; then
      die "gave up waiting for capacity after ${waited}s"
    fi
    log "retrying in ${CAPACITY_RETRY_SECONDS}s (Ctrl-C to give up)"
    sleep "$CAPACITY_RETRY_SECONDS"
    waited=$((waited + CAPACITY_RETRY_SECONDS))
  done
}

# Reads ~/.afk/current, written by the process that owns the session. Returns 1 if
# there is none or the server says it is over (a crashed owner can leave one behind),
# and 2 if the session is live but already has as many streams as the server allows.
load_current_session() {
  local file="$AFK_HOME/current" summary status stream_count max_streams
  [ -f "$file" ] || return 1
  SESSION_ID=$(sed -n 's/^sessionId=//p' "$file")
  INGEST_TOKEN=$(sed -n 's/^ingestToken=//p' "$file")
  AFK_SERVER=$(sed -n 's/^server=//p' "$file")
  DASHBOARD_URL=$(sed -n 's/^dashboardUrl=//p' "$file")
  [ -n "$SESSION_ID" ] && [ -n "$INGEST_TOKEN" ] || return 1
  summary=$(curl -sS --connect-timeout 5 --max-time 10 "$AFK_SERVER/api/sessions/$SESSION_ID" 2>/dev/null) || return 1
  status=$(json_get_string "$summary" status)
  if [ "$status" != "active" ]; then
    log "ignoring stale session file (session is ${status:-unknown})"
    rm -f "$file"
    return 1
  fi
  SESSION_DIR="$AFK_HOME/sessions/$SESSION_ID"
  MAX_DURATION_SECONDS=$(json_get_number "$summary" maxDurationSeconds)
  : "${MAX_DURATION_SECONDS:=3600}"
  stream_count=$(json_get_number "$summary" streamCount)
  max_streams=$(json_get_number "$summary" maxStreams)
  if [ -n "$stream_count" ] && [ -n "$max_streams" ] && [ "$stream_count" -ge "$max_streams" ]; then
    log "session $SESSION_ID already has $max_streams streams, the server's limit"
    return 2
  fi
}

end_session() {
  curl -sS -o /dev/null --connect-timeout 3 --max-time 5 -X POST \
    -H "Authorization: Bearer $INGEST_TOKEN" -H "X-Afk-Client: bash/$AFK_VERSION" \
    "$AFK_SERVER/api/sessions/$SESSION_ID/end" 2>/dev/null || true
  rm -f "$AFK_HOME/current" "$SESSION_DIR/response.json" "$SESSION_DIR/batch.ndjson"
}

# ---------------------------------------------------------------------------
# sampler: runs collectors on their interval, appends frames to current.ndjson
# ---------------------------------------------------------------------------

SEQ_SYSTEM=0
SEQ_PROCESSES=0
# Counts sampler ticks (one per SAMPLE_INTERVAL_SECONDS) so slower collectors can run
# every Nth tick; the first tick runs every collector so a session starts with each stream.
SAMPLE_TICK=0

emit_frame() { # stream collector data-json
  printf '{"stream":"%s","collector":"%s","sequence":%d,"timestamp":%d,"data":%s}\n' \
    "$1" "$2" "$3" "$(now_seconds)" "$4" >> "$SESSION_DIR/current.ndjson"
}

# True on the ticks a collector with this interval (in seconds) is due.
due_every() { # interval-seconds
  [ $(( (SAMPLE_TICK - 1) % ($1 / SAMPLE_INTERVAL_SECONDS) )) -eq 0 ]
}

sample_once() {
  SAMPLE_TICK=$((SAMPLE_TICK + 1))
  SEQ_SYSTEM=$((SEQ_SYSTEM + 1))
  emit_frame system system "$SEQ_SYSTEM" "$(collect_system)"
  if due_every "$PROCESSES_INTERVAL_SECONDS"; then
    SEQ_PROCESSES=$((SEQ_PROCESSES + 1))
    emit_frame processes processes "$SEQ_PROCESSES" "$(collect_processes)"
  fi
}

# ---------------------------------------------------------------------------
# sender: rotates current.ndjson into the queue, ships the oldest batches,
# deletes them on success, backs off and retries forever on failure
# ---------------------------------------------------------------------------

ROTATE_COUNTER=0

rotate_current() {
  local current="$SESSION_DIR/current.ndjson"
  [ -s "$current" ] || return 0
  ROTATE_COUNTER=$((ROTATE_COUNTER + 1))
  # mv is atomic; the sampler's next append recreates current.ndjson.
  # TODO(resilience): a printf that straddles the rename is theoretically possible
  # (macOS has no flock); a short pause before reading makes it practically impossible.
  mv "$current" "$SESSION_DIR/queue/$(printf '%010d' "$ROTATE_COUNTER").ndjson"
  sleep 0.1
}

# Sends up to SEND_MAX_FILES_PER_BATCH oldest queue files as one request.
# Returns 0 on success (files deleted), 1 on retryable failure, 2 on permanent failure
# (session over, or the server will no longer talk to this client version).
send_oldest_batch() {
  local batch="$SESSION_DIR/batch.ndjson" files="" count=0 f status
  for f in "$SESSION_DIR"/queue/*.ndjson; do
    [ -e "$f" ] || break
    files="$files $f"
    count=$((count + 1))
    [ "$count" -ge "$SEND_MAX_FILES_PER_BATCH" ] && break
  done
  [ "$count" -gt 0 ] || return 0

  # shellcheck disable=SC2086
  cat $files > "$batch"
  status=$(curl -sS -o "$SESSION_DIR/response.json" -w '%{http_code}' \
    --connect-timeout 5 --max-time 20 \
    -H "Authorization: Bearer $INGEST_TOKEN" -H 'Content-Type: application/x-ndjson' \
    -H "X-Afk-Client: bash/$AFK_VERSION" \
    --data-binary "@$batch" "$AFK_SERVER/api/sessions/$SESSION_ID/frames" 2>/dev/null) || status=000

  case "$status" in
    2*)
      # shellcheck disable=SC2086
      rm -f $files "$batch"
      return 0 ;;
    410)
      log "server closed the session ($(cat "$SESSION_DIR/response.json" 2>/dev/null))"
      return 2 ;;
    426)
      # The server stopped talking to this client version mid-session. Same outcome as
      # 410 (stop, keep the queue), plus the hint on how to update.
      log_upgrade_required "$(cat "$SESSION_DIR/response.json" 2>/dev/null)"
      return 2 ;;
    400|401|404|413|422)
      # The server will never accept this batch; keep it out of the way so we don't stall.
      # TODO(hardening): decide whether to keep these for debugging or drop them.
      log "server rejected batch with HTTP $status: $(cat "$SESSION_DIR/response.json" 2>/dev/null)"
      mkdir -p "$SESSION_DIR/rejected"
      # shellcheck disable=SC2086
      mv $files "$SESSION_DIR/rejected/"
      return 0 ;;
    *)
      return 1 ;;
  esac
}

sender_loop() {
  local backoff=1 rc
  while true; do
    rotate_current
    send_oldest_batch; rc=$?
    case "$rc" in
      0) backoff=1; sleep "$SEND_INTERVAL_SECONDS" ;;
      1) log "send failed, retrying in ${backoff}s (queued: $(ls "$SESSION_DIR/queue" | wc -l | tr -d ' ') batches)"
         sleep "$backoff"
         backoff=$((backoff * 2)); [ "$backoff" -gt "$SEND_MAX_BACKOFF_SECONDS" ] && backoff=$SEND_MAX_BACKOFF_SECONDS ;;
      2) touch "$SESSION_DIR/stop"; return ;;
    esac
  done
}

# Final attempt to drain the queue when the session ends. Best effort, short timeout.
flush_queue() {
  rotate_current
  while [ -n "$(ls "$SESSION_DIR/queue" 2>/dev/null)" ]; do
    send_oldest_batch || break
  done
}

# ---------------------------------------------------------------------------
# commands
# ---------------------------------------------------------------------------

# Samples machine health until the session is stopped (by the server via the
# sender, or by hitting the cap). Runs in the foreground for `afk start` and in the
# background for an `afk run` that had to start its own session.
system_sampler_loop() {
  local started
  started=$(now_seconds)
  while [ ! -e "$SESSION_DIR/stop" ]; do
    if [ $(( $(now_seconds) - started )) -ge "$MAX_DURATION_SECONDS" ]; then
      log "reached the maximum session length"
      # TODO(sessions): automatically start a new session and print the new URL instead.
      touch "$SESSION_DIR/stop"
      break
    fi
    sample_once
    sleep "$SAMPLE_INTERVAL_SECONDS"
    # TODO(sampling): subtract collector runtime so ticks stay closer to exactly 1 Hz.
  done
}

# ---------------------------------------------------------------------------
# qr code: the dashboard URL, drawn for a phone camera. Rendered by the server
# (bash has no QR library; see docs/PROTOCOL.md) and printed under the URL.
# ---------------------------------------------------------------------------

# Whether stdout is a terminal; the tests override this after sourcing the script.
stdout_is_terminal() { [ -t 1 ]; }

# Fetches the current session's QR code and prints it, block plus URL line, exactly as
# the server sent it. Prints nothing and returns 1 unless the server answered 200.
fetch_qr() {
  local file="$AFK_HOME/qr-$$.txt" status
  status=$(curl -sS -o "$file" -w '%{http_code}' --connect-timeout 3 --max-time 5 \
    -H "Authorization: Bearer $INGEST_TOKEN" -H "X-Afk-Client: bash/$AFK_VERSION" \
    "$AFK_SERVER/api/sessions/$SESSION_ID/qr" 2>/dev/null) || status=000
  if [ "$status" = 200 ]; then
    cat "$file"
    rm -f "$file"
    return 0
  fi
  rm -f "$file"
  return 1
}

# Prints the QR code after a session's URL, when it would be seen: only on a terminal
# (a pipe or a log file gets the URL alone) and not when --no-qr or AFK_NO_QR=1 turned
# it off. A failed fetch prints nothing; the session never depends on it.
print_qr() {
  if [ "${AFK_NO_QR:-0}" = 1 ]; then
    return 0
  fi
  stdout_is_terminal || return 0
  fetch_qr || true
}

cmd_qr() {
  local rc
  load_current_session; rc=$?
  # 2 means the session is live but full of streams, which is no reason not to show its URL.
  if [ "$rc" = 1 ]; then
    die "no active session on this machine (start one with 'afk start')"
  fi
  fetch_qr || die "could not fetch the QR code from $AFK_SERVER; the dashboard is at $DASHBOARD_URL"
}

cmd_start() {
  local arg
  for arg in "$@"; do
    case "$arg" in
      --no-qr) AFK_NO_QR=1 ;;
      *) die "unknown option: $arg (try 'afk help')" ;;
    esac
  done
  check_platform
  gather_host_info
  create_session_or_wait
  log "session $SESSION_ID started (max ${MAX_DURATION_SECONDS}s). Ctrl-C to end."
  printf '\n  %s\n\n' "$DASHBOARD_URL"
  print_qr

  sender_loop &
  SENDER_PID=$!

  finish() {
    trap - INT TERM
    log "ending session..."
    kill "$SENDER_PID" 2>/dev/null; wait "$SENDER_PID" 2>/dev/null
    flush_queue
    end_session
    log "session ended. Dashboard stays available at $DASHBOARD_URL"
    exit 0
  }
  trap finish INT TERM

  system_sampler_loop
  finish
}

cmd_run() {
  if [ "${1:-}" = "--no-qr" ]; then
    AFK_NO_QR=1
    shift
  fi
  [ "${1:-}" = "--" ] && shift
  [ $# -gt 0 ] || die "usage: afk run -- <command> [args...]"
  check_platform

  # Telemetry must never get in the way of the command itself: if the server is full
  # or the session already has its maximum number of streams, just run the command.
  local owner=0 joined
  load_current_session; joined=$?
  case "$joined" in
    0) log "joining session $SESSION_ID" ;;
    1)
      owner=1
      gather_host_info
      if ! create_session; then
        log "running without telemetry"
        exec "$@"
      fi
      log "no session running here; started $SESSION_ID with machine telemetry for the length of this command" ;;
    *)
      log "running without telemetry"
      exec "$@" ;;
  esac

  RUN_ID=$(random_id)
  RUN_STARTED=$(now_seconds)
  RUN_COMMAND_JSON=$(json_string "$*" | cut -c1-200)
  RUN_DIR="$AFK_HOME/sessions/$SESSION_ID/runs/$RUN_ID"
  mkdir -p "$RUN_DIR"
  if [ "$owner" = 0 ]; then
    # A joiner keeps its own spool so it never races the owner's sender.
    SESSION_DIR="$RUN_DIR"
    mkdir -p "$SESSION_DIR/queue"
  fi
  printf '\n  %s\n\n' "$DASHBOARD_URL"
  # A joiner's URL was already printed, QR and all, by the `afk start` that owns it.
  if [ "$owner" = 1 ]; then
    print_qr
  fi

  sender_loop &
  SENDER_PID=$!
  SYSTEM_PID=""
  if [ "$owner" = 1 ]; then
    system_sampler_loop &
    SYSTEM_PID=$!
  fi
  run_sampler_loop &
  RUN_SAMPLER_PID=$!

  # The command runs in the foreground so Ctrl-C and stdin behave as usual. Bash
  # would normally exit when a foreground child dies of SIGINT; trapping it lets us
  # still report the exit. The sh wrapper records the pid the sampler should watch.
  # TODO(run): tee adds a little latency to the final byte counts; a short pause covers it.
  trap ':' INT TERM
  sh -c 'echo $$ > "$1"; shift; exec "$@"' sh "$RUN_DIR/pid" "$@" \
    > >(tee -a "$RUN_DIR/stdout") 2> >(tee -a "$RUN_DIR/stderr" >&2)
  EXIT_CODE=$?
  trap - INT TERM

  kill "$RUN_SAMPLER_PID" 2>/dev/null; wait "$RUN_SAMPLER_PID" 2>/dev/null
  sleep 0.3
  local seq
  seq=$(( $(cat "$RUN_DIR/seq" 2>/dev/null || echo 0) + 1 ))
  emit_frame "run:$RUN_ID" run "$seq" "$(collect_run exited "$EXIT_CODE")"
  log "command exited with status $EXIT_CODE"

  if [ -n "$SYSTEM_PID" ]; then
    kill "$SYSTEM_PID" 2>/dev/null; wait "$SYSTEM_PID" 2>/dev/null
  fi
  kill "$SENDER_PID" 2>/dev/null; wait "$SENDER_PID" 2>/dev/null
  flush_queue
  if [ "$owner" = 1 ]; then
    end_session
    log "session ended. Dashboard stays available at $DASHBOARD_URL"
  fi
  exit "$EXIT_CODE"
}

usage() {
  sed -n '2,/^$/p' "$0" | sed 's/^# \{0,1\}//'
}

main() {
  case "${1:-}" in
    start)   shift; cmd_start "$@" ;;
    run)     shift; cmd_run "$@" ;;
    qr)      cmd_qr ;;
    version) printf 'afk %s\n' "$AFK_VERSION" ;;
    -h|--help|help|"") usage ;;
    *)       die "unknown command: $1 (try 'afk help')" ;;
  esac
}

# Sourcing the script with AFK_SOURCED=1 loads the functions without running anything,
# which is how the tests exercise them.
if [ "${AFK_SOURCED:-0}" != 1 ]; then
  main "$@"
fi
