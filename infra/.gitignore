# OpenTofu working files and state (local backend -- see versions.tf).
.terraform/
*.tfstate
*.tfstate.*
crash.log
crash.*.log

# Real variable files (bucket name, profile overrides, etc). The lock file
# (.terraform.lock.hcl) and terraform.tfvars.example are NOT ignored -- both
# should be committed.
*.tfvars
*.tfvars.json

# Key material never belongs in the repo. The old instance-based design kept its
# deploy SSH key pair here; that pair is deleted (the container service has no SSH
# access), the rule stays as a guard.
.ssh/
