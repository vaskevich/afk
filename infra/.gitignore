# OpenTofu working files and state (local backend -- see versions.tf).
.terraform/
*.tfstate
*.tfstate.*
crash.log
crash.*.log

# Real variable files (bucket name, profile overrides, etc). The lock file
# (.terraform.lock.hcl) and terraform.tfvars.example are NOT ignored -- both
# should be committed.
*.tfvars
*.tfvars.json

# Leftover deploy SSH key pair from the old instance-based design. No longer used
# (the container service has no SSH access) but left in place and gitignored
# rather than deleted -- see README.
.ssh/
